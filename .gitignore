# ---------------------------------------------------------------------------
# ref_repo：外部 baseline / 对照仓库的镜像。纳入版本控制时只保留源码与说明文档，
# 通过忽略权重、压缩包、训练与推理产物控制体积（clone 后大文件请走网盘 / 环境变量路径）。
# 哪些该推、哪些不该推的人类可读说明：docs/temp/ref_repo_push_policy.md
# ---------------------------------------------------------------------------
ref_repo/**/__pycache__/
ref_repo/**/*.py[cod]
ref_repo/**/.eggs/
ref_repo/**/build/
ref_repo/**/dist/
ref_repo/**/.mypy_cache/
ref_repo/**/wandb/
ref_repo/**/mlruns/
ref_repo/**/outputs/
ref_repo/**/output/
ref_repo/**/runs/
ref_repo/**/logs/
ref_repo/**/log/
ref_repo/**/results/
ref_repo/**/tmp/
ref_repo/**/temp/
ref_repo/**/.cache/
ref_repo/**/cache/
ref_repo/**/checkpoints/
ref_repo/**/checkpoint*/
ref_repo/**/ckpt/
ref_repo/**/ckpts/
ref_repo/**/save/
ref_repo/**/saved/
ref_repo/**/pretrained/
ref_repo/**/weights/
# 训练实验目录命名各异，一律排除生成物（仅保留源码 add）
ref_repo/**/work_dirs/
ref_repo/**/exp/
ref_repo/**/exps/
ref_repo/**/experiments/
ref_repo/**/tensorboard/
ref_repo/**/tb_logs/
ref_repo/**/tensorflow_log/
# 数据与中间件（各子项目若需小样本，用 ! 规则白名单，或放 data/ 外单独说明）
ref_repo/**/data/
ref_repo/**/datasets/
ref_repo/**/body_models/
# MoGenDiT 等使用单数目录名 body_model/（SMPL 网格与 pickle，体积可达数百 MB）
ref_repo/**/body_model/
ref_repo/**/human_body_prior/
ref_repo/**/smpl/
ref_repo/**/SMPL*/
# Python 虚拟环境（baseline 目录内常残留）
ref_repo/**/.venv/
ref_repo/**/venv/
# 压缩与镜像
ref_repo/**/*.zip
ref_repo/**/*.rar
ref_repo/**/*.7z
ref_repo/**/*.tar
ref_repo/**/*.tar.xz
ref_repo/**/*.xz
ref_repo/**/*.tgz
ref_repo/**/*.tar.gz
# 模型与数值大文件（根级已有 *.pt / *.bin / *.safetensors；ref 里常见扩展再显式列一次）
ref_repo/**/*.pth
ref_repo/**/*.ckpt
ref_repo/**/*.pkl
ref_repo/**/*.onnx
ref_repo/**/*.index
ref_repo/**/*.npz
ref_repo/**/*.npy
ref_repo/**/*.h5
ref_repo/**/*.hdf5
ref_repo/**/node_modules/
ref_repo/**/.pytest_cache/
# 子仓 .git 若用「整目录 add」方式合并，可删子目录 .git 后提交；若暂保留子仓，不要 track 其 .git 对象
ref_repo/**/.git/
# Stage logs of one-shot setup scripts (downloads / unzips). Keep the .sh, drop the logs.
ref_repo/_eval_setup_logs/
# Embedded git clones used as local references. Track only our own glue scripts + paper PDFs
# inside these dirs via explicit unignore rules below.
ref_repo/Momask/momask-codes/
ref_repo/MotionStreamer/MotionStreamer/
ref_repo/MotionStreamer/272-dim-Motion-Representation/
!ref_repo/MotionStreamer/MotionStreamer/eval_with_motionstreamer_evaluator.py
# 基准代码旁的 CLAUDE 说明仍希望随 ref_repo 一并入库（需写在全局 CLAUDE.md 规则之后）
!ref_repo/**/CLAUDE.md

