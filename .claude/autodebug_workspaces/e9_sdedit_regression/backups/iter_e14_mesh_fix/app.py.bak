# ── Caption Rewriter API (Text2MotionPrompter) ──────────────
REWRITER_URL = "http://11.216.46.236:8080/v1/chat/completions"
REWRITER_MODEL = "Qwen3-30B-A3B-GRPO"
REWRITER_SYSTEM_PROMPT = """# Role
You are an expert in 3D motion analysis, animation timing, and choreography.

# Task
Analyze the user-provided [Input Action] and generate a structured JSON response containing a duration estimate and a refined caption.

# Instructions

### 1. Duration Estimation (frame_count)
- Estimate time for smooth, natural, realistic performance
- Calculate duration in frames at 30 fps (frames per second)
- Output strictly as an Integer

### 2. Caption Refinement (short_caption)
- Generate refined, grammatically correct English version
- PRESERVE original sequence of events (chronological order)
- RETAIN all original spatial modifiers
- DO NOT add new sub-actions or hallucinate details
- DO NOT delete any specific movements
- Goal: improve clarity while maintaining 100% semantic fidelity

### 3. Output Format
Return ONLY a raw JSON object (no markdown):
{
    "duration": <Integer frames at 30fps>,
    "short_caption": "<String, refined English description>"
}"""


@app.route("/api/rewrite_caption", methods=["POST"])
def api_rewrite_caption():
    """Rewrite a caption using the Text2MotionPrompter service."""
    import requests as _req

    data = request.json or {}
    caption = data.get("caption", "").strip()
    if not caption:
        return jsonify({"error": "caption is required"}), 400

    try:
        resp = _req.post(REWRITER_URL, json={
            "model": REWRITER_MODEL,
            "messages": [
                {"role": "system", "content": REWRITER_SYSTEM_PROMPT},
                {"role": "user", "content": f"[Input Action]: {caption}"},
            ],
            "max_tokens": 200,
            "temperature": 0.3,
        }, timeout=30)

        if resp.status_code != 200:
            return jsonify({"error": f"Rewriter service returned {resp.status_code}"}), 502

        content = resp.json()["choices"][0]["message"]["content"]
        # Strip thinking tags if present
        if "</think>" in content:
            content = content.split("</think>")[-1].strip()

        result = json.loads(content)
        return jsonify({
            "original": caption,
            "rewritten": result.get("short_caption", caption),
            "duration_frames": result.get("duration", 0),
        })
    except Exception as e:
        return jsonify({"error": f"Rewrite failed: {str(e)}"}), 500


