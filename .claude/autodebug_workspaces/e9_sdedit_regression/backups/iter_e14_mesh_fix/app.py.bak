@app.route("/")
def index():
    """Home page: task cards + model list + recent runs."""
    stats = db.get_dashboard_stats()
    models = db.get_all_models()
    # Pass current-registry task IDs so frontend datalist fetch doesn't hardcode
    # stale IDs (E11, E12, …) that were pruned.
    all_task_ids = [t.task_id for t in get_all_tasks()]
    return render_template("index.html", stats=stats, models=models,
                           all_task_ids=all_task_ids)


@app.route("/task/<task_id>")
def task_detail(task_id: str):
    """Single task detail page."""
    task = get_task(task_id)
    if not task:
        abort(404)
    runs = db.get_eval_runs(task_id=task_id)
    comparison = db.get_task_comparison(task_id)
    baselines = db.get_baselines(task_id=task_id)

    # Build comparison table: {model_name: {setting: {metric: value}}}
    # Skip runs flagged as [RERUNNING ...] in notes — those are stale results
    # kept only so that users can see "<model> (rerunning)" badges and know
    # fresh numbers are on the way. We do NOT want them polluting the radar /
    # bar charts.
    RERUN_TAG = '[RERUNNING'
    comp_table = {}
    rerunning_entries = []  # [(model_name, setting), ...] from skipped rows
    seen_rerun = set()
    for row in comparison:
        notes = row.get('run_notes') or ''
        if RERUN_TAG in notes:
            pair = (row['model_name'], row['setting'])
            if pair not in seen_rerun:
                rerunning_entries.append({
                    'model_name': row['model_name'],
                    'setting': row['setting'],
                })
                seen_rerun.add(pair)
            continue
        key = f"{row['model_name']} ({row['setting']})"
        if key not in comp_table:
            comp_table[key] = {"run_id": row["run_id"], "model_name": row["model_name"],
                               "setting": row["setting"], "metrics": {}}
        comp_table[key]["metrics"][row["metric_name"]] = {
            "mean": row["mean"], "std": row["std"],
            "median": row["median"], "min": row["min_val"], "max": row["max_val"],
        }

    # Add baselines to comparison
    for bl in baselines:
        key = f"{bl['name']} ({bl['setting']})"
        if bl.get("skeleton_type") != "smpl22":
            key += f" [{bl['skeleton_type']}]"
        comp_table[key] = {
            "run_id": None, "model_name": bl["name"],
            "setting": bl["setting"], "is_baseline": True,
            "skeleton_type": bl.get("skeleton_type", "smpl22"),
            "metrics": {k: {"mean": v} for k, v in bl["metrics"].items()},
        }

    # Collect all metric names that appear
    all_metrics = set()
    for entry in comp_table.values():
        all_metrics.update(entry["metrics"].keys())
    # Sort: task default metrics first, then alphabetical
    default_m = task.default_metrics
    sorted_metrics = [m for m in default_m if m in all_metrics]
    sorted_metrics += sorted(m for m in all_metrics if m not in default_m)

    # Hide rerunning runs from the ALL_RUNS list the viewer uses for sample
    # browsing / compare mode — those NPZ files may be stale / from the old
    # caption cache. Keep them in rerunning_entries for the UI badge only.
    runs_visible = [r for r in runs
                    if not (r.get('notes') and RERUN_TAG in (r['notes'] or ''))]

    return render_template(
        "task_detail.html",
        task=task,
        runs=runs_visible,
        comp_table=comp_table,
        sorted_metrics=sorted_metrics,
        baselines=baselines,
        rerunning_entries=rerunning_entries,
    )


@app.route("/compare")
def model_comparison():
    """Multi-model comparison page."""
    models = db.get_all_models()
    tasks = get_all_tasks()

    # Build cross-task comparison data
    all_runs = db.get_eval_runs()
    # {model_name: {task_id: {metric: mean}}}
    model_task_metrics = {}
    for run in all_runs:
        mname = run["model_name"]
        tid = run["task_id"]
        if mname not in model_task_metrics:
            model_task_metrics[mname] = {}
        metrics = db.get_agg_metrics(run["id"])
        model_task_metrics[mname][tid] = {m["metric_name"]: m["mean"] for m in metrics}

    return render_template(
        "model_comparison.html",
        models=models,
        tasks=tasks,
        tasks_json=json.dumps([t.to_dict() for t in tasks]),
        models_json=json.dumps(models),
        model_task_metrics=model_task_metrics,
    )


