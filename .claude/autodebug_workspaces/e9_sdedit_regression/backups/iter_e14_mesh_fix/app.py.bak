# ── LRU cache for expensive SMPL param computation ──────────────
from functools import lru_cache
import hashlib

@lru_cache(maxsize=128)
def _cached_smpl_params(npz_path: str, rotation_space: str, mtime: float):
    """Cache SMPL params keyed by path + rotation_space + file mtime."""
    return load_npz_smpl_params(npz_path, rotation_space)
app.secret_key = "eval-dashboard-secret-2026"

# Enable gzip compression for JSON API responses to prevent proxy 502 on large payloads
import gzip as _gzip
from io import BytesIO as _BytesIO

@app.after_request
def compress_response(response):
    if (response.status_code == 200
            and response.content_type
            and 'json' in response.content_type
            and not response.direct_passthrough):
        accept_enc = request.headers.get('Accept-Encoding', '')
        if 'gzip' not in accept_enc:
            return response
        data = response.get_data()
        if len(data) < 1000:
            return response
        buf = _BytesIO()
        with _gzip.GzipFile(fileobj=buf, mode='wb', compresslevel=6) as gz:
            gz.write(data)
        compressed = buf.getvalue()
        response.set_data(compressed)
        response.headers['Content-Encoding'] = 'gzip'
        response.headers['Content-Length'] = len(compressed)
        response.headers['Vary'] = 'Accept-Encoding'
    return response

