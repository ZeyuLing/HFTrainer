/**
 * Stitch full source motions around network output for E14.
 *
 * Mutates posData.positions in-place: prepends prefix frames and appends suffix
 * frames from the source motions. Updates posData.num_frames.
 * Sets sourceMotionCtx so computeFrameMask() can assign region=2 (Not Input).
 *
 * For E14: [A_remaining(gray) | A_tail+transition+B_head(network) | B_remaining(gray)]
 * For E15: NPZ already contains full [P(1) + transition + A_full] — no
 *          stitching applied. Coloring handled by _computeNetworkMask.
 */
function stitchSourceMotions(posData, srcData, taskId) {
    // Thin wrapper over stitchSourceMotionsGeneric that operates on the global
    // single-viewer state (smplData + sourceMotionCtx).
    const ctx = stitchSourceMotionsGeneric(posData, smplData, srcData, taskId);
    if (ctx) sourceMotionCtx = ctx;
}

function stitchSourceMotionsGeneric(posData, smplDataObj, srcData, taskId) {
    // Stitch prefix/suffix source-motion frames into posData.positions and
    // (if provided) smplDataObj.frames. Returns a sourceMotionCtx descriptor
    // {prefixLen, suffixLen, networkLen, totalLen} or null if no stitching
    // happened. Idempotent: guards both posData and smplDataObj with _stitched.
    if (!posData || !posData.positions) return null;

    // Determine N_cond from setting. Note: currentSetting is a module-global
    // selected by the user. In compare mode the viewer's actual setting may
    // differ per viewer (each run has its own setting) but they all share the
    // same underlying source-motion spec so currentSetting works as a proxy.
    const nc = currentSetting === 'A' ? 5 : currentSetting === 'B' ? 15 : 30;

    let prefixPositions = null;  // frames to prepend (gray)
    let suffixPositions = null;  // frames to append (gray)
    let prefixSMPLFrames = null; // SMPL frames for prefix
    let suffixSMPLFrames = null; // SMPL frames for suffix

    if (taskId === 'E14') {
        const motA = srcData.motion_a;
        const motB = srcData.motion_b;
        if (motA && motA.positions && motA.positions.length > nc) {
            prefixPositions = motA.positions.slice(0, -nc);
            prefixSMPLFrames = motA.smpl_frames ? motA.smpl_frames.slice(0, -nc) : null;
        }
        if (motB && motB.positions && motB.positions.length > nc) {
            suffixPositions = motB.positions.slice(nc);
            suffixSMPLFrames = motB.smpl_frames ? motB.smpl_frames.slice(nc) : null;
        }
    } else if (taskId === 'E15') {
        // E15 (2026-04-21 redefinition): NPZ already contains the full
        // sequence [P(1) + transition(N-1) + A_full]. No source-motion
        // stitching needed — per-frame coloring handled by _computeNetworkMask.
        // Leave prefix/suffix empty so stitchSourceMotions() short-circuits.
    }

    const prefixLen = prefixPositions ? prefixPositions.length : 0;
    const suffixLen = suffixPositions ? suffixPositions.length : 0;

    if (prefixLen === 0 && suffixLen === 0) return null;

    // Stitch positions only if not already stitched.
    // (stitchSourceMotions may be called twice: once with only posData available,
    //  then again after smplData arrives to stitch the SMPL frames.)
    if (!posData._stitched) {
        const networkLen = posData.positions.length;
        const stitched = [];
        if (prefixPositions) stitched.push(...prefixPositions);
        stitched.push(...posData.positions);
        if (suffixPositions) stitched.push(...suffixPositions);
        posData.positions = stitched;
        posData.num_frames = stitched.length;
        posData._stitched = true;
        posData._networkLen = networkLen;
        posData._prefixLen = prefixLen;
        posData._suffixLen = suffixLen;
    }

    // Stitch SMPL frames if available and not already stitched (for mesh rendering)
    if (smplDataObj && smplDataObj.frames && !smplDataObj._stitched) {
        const genLen = smplDataObj.frames.length;
        const stitchedSMPL = [];
        if (prefixSMPLFrames) stitchedSMPL.push(...prefixSMPLFrames);
        stitchedSMPL.push(...smplDataObj.frames);
        if (suffixSMPLFrames) stitchedSMPL.push(...suffixSMPLFrames);
        smplDataObj.frames = stitchedSMPL;
        smplDataObj.num_frames = stitchedSMPL.length;
        smplDataObj._stitched = true;
        smplDataObj._genStart = prefixLen;
        smplDataObj._genLen = genLen;
    }

    // Return ctx descriptor using the ORIGINAL network length (stored on posData),
    // not the post-stitch length. This is essential for drawFrame() to correctly
    // map currentFrame → (prefix | network | suffix) regions.
    return {
        prefixLen: posData._prefixLen || prefixLen,
        suffixLen: posData._suffixLen || suffixLen,
        networkLen: posData._networkLen || posData.positions.length,
        totalLen: posData.positions.length,
    };
}

function loadCurrentSample() {
    const s = filteredSamples[currentIdx];
    if (!s) return;

    document.getElementById('sampleCaption').textContent = s.text_caption || '(no caption)';

    // Show/hide caption bar and rewrite button
    const captionBar = document.getElementById('captionBar');
    const btnRewrite = document.getElementById('btnRewriteCaption');
    const rewrittenSpan = document.getElementById('rewrittenCaption');
    if (captionBar) {
        captionBar.style.display = (s.text_caption && s.text_caption.trim()) ? 'block' : 'none';
    }
    // Show rewrite button for non-English or short captions
    if (btnRewrite) {
        const cap = (s.text_caption || '').trim();
        const hasNonAscii = /[^\x00-\x7F]/.test(cap);
        const isShort = cap.split(/\s+/).length <= 4;
        btnRewrite.style.display = (cap && (hasNonAscii || isShort)) ? 'inline-block' : 'none';
        btnRewrite.disabled = false;
        btnRewrite.innerHTML = '<i class="fas fa-language me-1"></i>Rewrite';
    }
    if (rewrittenSpan) rewrittenSpan.style.display = 'none';

    // Build NPZ path: prefer gen_motion_path (direct _npz_path)
    // Only use npzDir fallback if sample has valid metrics (not an error/skipped sample)
    let npzPath = '';
    if (s.gen_motion_path) {
        npzPath = s.gen_motion_path;
    } else if (currentNpzDir && s.prompt_id && s.metrics && Object.keys(s.metrics).length > 0) {
        npzPath = `${currentNpzDir}/${s.prompt_id}.npz`;
    }
    document.getElementById('fullViewerLink').href = `/viewer?path=${encodeURIComponent(npzPath)}`;

    // Show "no visualization" message when no NPZ path available
    const viewerEl = document.getElementById('smplViewer');
    if (!npzPath) {
        if (viewerEl && !viewerEl.querySelector('.no-viz-msg')) {
            // Don't init Three.js, just show message overlay
            const msg = document.createElement('div');
            msg.className = 'no-viz-msg';
            msg.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:var(--text-muted);font-size:0.9rem;text-align:center;pointer-events:none;z-index:5;';
            msg.innerHTML = '<i class="fas fa-cube" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:0.5rem;"></i>No 3D visualization available<br><small>Aggregate metrics only for this task</small>';
            viewerEl.style.position = 'relative';
            viewerEl.appendChild(msg);
        }
    } else {
        // Remove message if present
        const oldMsg = viewerEl ? viewerEl.querySelector('.no-viz-msg') : null;
        if (oldMsg) oldMsg.remove();
    }

    // Per-sample metrics
    const metricsDiv = document.getElementById('sampleMetrics');
    let mhtml = '<div class="sample-metric-grid">';
    Object.entries(s.metrics || {}).forEach(([k, v]) => {
        if (Array.isArray(v)) return;
        const meta = metricMeta[k];
        const label = meta ? meta[0] : k;
        const fmt = typeof v === 'number' ? (Math.abs(v) < 0.01 ? v.toExponential(2) : v.toFixed(4)) : v;
        mhtml += `<div class="sample-metric-item"><div class="metric-label">${label}</div><div class="metric-val">${fmt}</div></div>`;
    });
    mhtml += '</div>';
    metricsDiv.innerHTML = mhtml;

    // Load motion for rendering
    if (npzPath) {
        // Stop current playback during load
        if (framePlaying) toggleFramePlay();

        const thisLoad = ++loadGeneration; // cancel any in-flight loads

        // Cleanup old mesh before loading new one (fix case switch bug)
        if (smplMesh && scene) { scene.remove(smplMesh); smplMesh.geometry.dispose(); smplMesh.material.dispose(); smplMesh = null; smplBones = null; smplSkeleton = null; }
        if (skeletonGroup && scene) { scene.remove(skeletonGroup); skeletonGroup = null; }
        if (meshSeqMesh && scene) { scene.remove(meshSeqMesh); meshSeqMesh.geometry.dispose(); meshSeqMesh.material.dispose(); meshSeqMesh = null; }
        // Reset data so stale smpl/skeleton from a previous sample doesn't get re-used
        // (important for stitching logic: a lingering smplData would cause premature stitch)
        smplData = null; skeletonData = null; meshSeqData = null;
        sourceMotionCtx = null;
        // E9 LQ overlay: clear cached LQ motion + mesh/skeleton for the previous sample.
        // (The toggle button state is preserved so if the user had it enabled, the new
        // sample's LQ will auto-load on next toggleLQOverlay call.)
        _clearLQOverlay();
        lqOverlayData = null;
        // Hide QC diagnosis panel while the new sample's LQ/defect info loads
        const _qcPanelEl = document.getElementById('e9QcPanel');
        if (_qcPanelEl) _qcPanelEl.style.display = 'none';

        // E9: auto-enable LQ ghost overlay on first sample load so users see
        // the defective input motion + repaired output side-by-side without
        // having to discover the (small) toggle button. They can still turn
        // it off with the button.
        if (TASK_ID === 'E9' && !window._e9AutoOverlayInitialized) {
            window._e9AutoOverlayInitialized = true;
            lqOverlayEnabled = true;
            const btn = document.getElementById('btnLQOverlay');
            if (btn) {
                btn.classList.add('active');
                btn.innerHTML = '<i class="fas fa-eye"></i> LQ mesh';
            }
        }

        initThreeJS().then(async () => {
            try {
                // Strategy: Load skeleton FIRST (fast, ~20ms) for immediate display,
                // then upgrade to SMPL mesh in background (slow, ~5-9s).
                const smplUrl = `/api/smpl/${npzPath.replace(/^\/+/, '')}?rotation_space=${currentRotSpace}`;
                const posUrl = `/api/npz/${npzPath.replace(/^\/+/, '')}`;

                // Hoist these to the outer async scope so the SMPL-upgrade .then()
                // callback below can reference them (required for E14/15/16 to stitch
                // prefix/suffix SMPL frames after the mesh arrives).
                let posData = null;
                let sourceMotionData = null;

                // 1. Load positions immediately for skeleton rendering + overlays
                posData = await fetch(posUrl).then(r => r.json()).catch(() => null);
                if (thisLoad !== loadGeneration) return;

                if (posData && !posData.error) {
                    // For E14: fetch source motions and stitch
                    sourceMotionCtx = null;
                    if ((TASK_ID === 'E14') && s.prompt_id) {
                        try {
                            const srcResp = await fetch(`/api/source_motions/${TASK_ID}/${s.prompt_id}`);
                            if (srcResp.ok) {
                                sourceMotionData = await srcResp.json();
                                if (thisLoad !== loadGeneration) return;
                                stitchSourceMotions(posData, sourceMotionData, TASK_ID);
                            }
                        } catch(e) { /* continue without source motions */ }
                    }

                    skeletonData = posData;
                    renderMode = 'skeleton';
                    loadSkeletonFromPositions(posData);

                    const nf = skeletonData.num_frames || 1;
                    document.getElementById('frameSlider').max = nf - 1;
                    document.getElementById('frameSlider').value = 0;
                    renderMaskBar(nf);
                    drawFrame();
                    canonicalizeGround();
                    // Auto-frame the camera so long-trajectory motions (e.g. E1 KIMODO walks,
                    // E14/15/16 stitched source motions) are not rendered outside the default
                    // frustum. Short in-place motions near origin are preserved via an internal
                    // heuristic inside autoFrameCameraToMotion.
                    autoFrameCameraToMotion();
                    drawConstraintMarkers();
                    initBodyPartOverlay();
                    // E9: if LQ overlay is currently enabled (either manually
                    // toggled or auto-enabled for the first sample), fetch the
                    // LQ motion now so both the defective input and the
                    // repair output are visible from the first frame.
                    if (TASK_ID === 'E9' && lqOverlayEnabled) {
                        const s = filteredSamples[currentIdx];
                        if (s && s.prompt_id) {
                            fetch(`/api/e9_lq/${encodeURIComponent(s.prompt_id)}`)
                                .then(async d0 => d0.json()).then(async d => {
                                    if (thisLoad !== loadGeneration) return;
                                    if (d && d.lq_motion && d.lq_motion.positions) {
                                        lqOverlayData = d.lq_motion;
                                        lqOverlayData._pid = s.prompt_id;
                                        lqOverlayData.adaptive_mask_frames = d.adaptive_mask_frames || [];
                                        lqOverlayData.adaptive_joint_mask = d.adaptive_joint_mask || null;
                                        lqOverlayData.defect_type = d.defect_type || '';
                                        await _buildLQMeshOverlay(lqOverlayData);
                                        _applyE9ViewerOffsets(true);
                                        drawFrame();
                                    }
                                    // Fill the QC diagnosis panel regardless of
                                    // whether motion fetch succeeded — the list of
                                    // defect types is useful even when the LQ npz
                                    // is missing.
                                    const qcPanel = document.getElementById('e9QcPanel');
                                    if (qcPanel) {
                                        const defects = (d && d.all_defects && d.all_defects.length)
                                            ? d.all_defects
                                            : (d && d.defect_type ? [d.defect_type] : []);
                                        document.getElementById('e9DefectList').textContent =
                                            defects.length ? defects.join(', ') : '(no checker flags)';
                                        const numDefFrames = (d && Array.isArray(d.adaptive_mask_frames))
                                            ? d.adaptive_mask_frames.length : 0;
                                        document.getElementById('e9DefectFrames').textContent =
                                            numDefFrames > 0 ? `${numDefFrames}` : 'none marked';
                                        qcPanel.style.display = '';
                                    }
                                }).catch(() => {});
                        }
                    }
                    if (!framePlaying) toggleFramePlay();
                }

                // 2. Upgrade to SMPL mesh in background
                fetch(smplUrl).then(r => r.json()).then(async data => {
                    if (thisLoad !== loadGeneration) return;
                    if (data.error) return; // stay with skeleton

                    if (data.type === 'mesh_sequence') {
                        renderMode = 'mesh_seq';
                        meshSeqData = data;
                        // Hide skeleton when upgrading to mesh
                        if (skeletonGroup && scene) { skeletonGroup.visible = false; }
                        loadMeshSequence(data);
                        // mesh_sequence vertices are already in world space — recompute ground from vertices
                        groundOffset = 0;
                        if (meshSeqMesh) {
                            const posAttr = meshSeqMesh.geometry.getAttribute('position');
                            let meshMinY = Infinity;
                            for (let i = 0; i < posAttr.count; i++) {
                                if (posAttr.getY(i) < meshMinY) meshMinY = posAttr.getY(i);
                            }
                            if (meshMinY !== Infinity) {
                                groundOffset = -meshMinY;
                                meshSeqMesh.position.y = groundOffset;
                            }
                        }
                        drawFrame(); // refresh with new render mode
                    } else if (data.frames) {
                        try {
                            renderMode = 'smpl';
                            // Hide skeleton when upgrading to SMPL mesh
                            if (skeletonGroup && scene) { skeletonGroup.visible = false; }
                            await loadSMPLMesh(data);
                            if (thisLoad !== loadGeneration) return;
                            smplData = data;

                            // For stitched tasks (E14/15/16), now that smplData is available,
                            // re-stitch to include prefix/suffix SMPL frames.
                            // stitchSourceMotions is idempotent (guards via _stitched flag)
                            // so this only appends prefix/suffix to smplData.frames; posData
                            // was already stitched earlier and is left untouched.
                            if ((TASK_ID === 'E14') && sourceMotionData) {
                                stitchSourceMotions(posData, sourceMotionData, TASK_ID);
                                // Refresh mask bar in case stitched smpl length adjusted totalLen
                                if (skeletonData && skeletonData.num_frames) {
                                    renderMaskBar(skeletonData.num_frames);
                                }
                            }

                            // Draw frame 0 first so mesh skinning is applied in actual world coords
                            if (smplMesh) smplMesh.position.y = 0;
                            drawFrame();
                            // Now re-compute groundOffset from the actual rendered SMPL mesh.
                            // SMPL rest mesh leg length (~0.92m) typically differs from the
                            // training-data leg length used by skeleton FK, so using skeleton
                            // positions for grounding leaves the mesh ~10-20cm floating.
                            recomputeSMPLGroundFromMesh();
                            drawFrame();
                        } catch(meshErr) {
                            // Keep skeleton, make it visible again
                            renderMode = 'skeleton';
                            if (skeletonGroup) skeletonGroup.visible = true;
                        }
                    }
                }).catch(() => { /* stay with skeleton */ });

                currentFrame = 0;
            } catch(e) {
                console.warn('Motion load failed:', e);
            }
        });
    }
}

