{% extends "base.html" %}
{% block title %}{{ task.task_id }}: {{ task.name }} - Eval Dashboard{% endblock %}

{% block extra_head %}
<script type="importmap">
{
    "imports": {
        "three": "/static/three/three.module.js",
        "three/addons/": "/static/three/jsm/"
    }
}
</script>
<style>
    .sample-metric-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(145px, 1fr)); gap: 0.4rem; }
    .sample-metric-item {
        background: var(--bg-card); border: 1px solid var(--border-soft); border-radius: var(--radius-sm);
        padding: 0.35rem 0.5rem; font-size: 0.75rem;
    }
    .sample-metric-item .metric-label { color: var(--text-muted); font-size: 0.68rem; }
    .sample-metric-item .metric-val { color: var(--text-bright); font-family: "JetBrains Mono", monospace; font-weight: 600; }
    .viewer-canvas { width: 100%; height: 500px; background: #080a10; border-radius: var(--radius-sm); }
    .sample-nav-btn { min-width: 36px; }
    .sample-list-item {
        padding: 0.4rem 0.6rem; border-radius: var(--radius-sm); cursor: pointer;
        font-size: 0.78rem; border: 1px solid transparent; transition: all 0.1s;
    }
    .sample-list-item:hover { background: rgba(255,255,255,0.03); }
    .sample-list-item.active { background: var(--bg-accent-soft); border-color: rgba(37,99,235,0.3); }
    .sample-sidebar { max-height: 500px; overflow-y: auto; }
    /* Compare mode */
    .compare-grid { display: grid; gap: 0.75rem; }
    .compare-grid.cols-2 { grid-template-columns: 1fr 1fr; }
    .compare-grid.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
    .compare-grid.cols-4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
    .compare-viewer-cell { position: relative; }
    .compare-viewer-cell .viewer-canvas { height: 400px; }
    .compare-viewer-label {
        position: absolute; top: 8px; left: 8px; z-index: 5;
        font-size: 0.72rem; font-weight: 700; padding: 3px 10px;
        border-radius: 999px; background: rgba(37,99,235,0.8); color: #fff;
    }
    .btn-compare.active { background: var(--bg-accent); color: #fff; border-color: var(--bg-accent); }
    .compare-run-selector { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
    .compare-run-chip {
        font-size: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 999px; cursor: pointer;
        border: 1px solid var(--border-strong); color: var(--text-muted); background: transparent;
        transition: all 0.15s;
    }
    .compare-run-chip.selected { background: var(--bg-accent-soft); border-color: rgba(37,99,235,0.5); color: var(--text-bright); }
    .compare-run-chip:hover { border-color: var(--text-muted); }
    /* Pie chart filter badge */
    .pie-filter-badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.3);
        border-radius: 999px; padding: 4px 12px 4px 10px; font-size: 0.78rem;
        color: var(--text-bright); cursor: default;
    }
    .pie-filter-badge .clear-btn {
        cursor: pointer; opacity: 0.6; font-size: 0.9rem; margin-left: 2px;
    }
    .pie-filter-badge .clear-btn:hover { opacity: 1; }
</style>
{% endblock %}

{% block content %}
<!-- Header -->
<div class="d-flex align-items-center gap-3 mb-3">
    <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div class="task-icon" style="background: {{ task.color }}22; color: {{ task.color }}; width:48px; height:48px; border-radius:var(--radius-md); display:flex; align-items:center; justify-content:center; font-size:1.2rem;">
        <i class="fas {{ task.icon }}"></i>
    </div>
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="task-id" style="font-size:0.85rem;">{{ task.task_id }}</span>
            <span class="badge-phase badge-phase-{{ task.phase }}">Phase {{ task.phase }}</span>
            {% if task.kimodo_comparable %}
                <span class="badge-outline badge-kimodo"><i class="fas fa-scale-balanced me-1"></i>KIMODO comparable</span>
            {% endif %}
            {% if task.needs_caption %}
                <span class="badge-outline badge-caption"><i class="fas fa-comment me-1"></i>Caption</span>
            {% endif %}
            {% if task.needs_gt %}
                <span class="badge-outline badge-gt"><i class="fas fa-bullseye me-1"></i>Needs GT</span>
            {% endif %}
        </div>
        <h4 class="mb-0 mt-1" style="font-weight:800; color:var(--text-bright);">{{ task.name }}</h4>
        <p class="mb-0 text-muted" style="font-size:0.85rem;">{{ task.description }}</p>
    </div>
</div>

<!-- Task Settings & Metrics Overview -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="dash-card h-100">
            <h6 style="color:var(--text-bright); font-weight:700; margin-bottom:0.75rem;">
                <i class="fas fa-sliders me-2" style="opacity:0.5;"></i>Settings ({{ task.settings|length }})
            </h6>
            <div class="d-flex flex-column gap-2">
                {% for key, s in task.settings.items() %}
                <div style="background:var(--bg-surface); border:1px solid var(--border-soft); border-radius:var(--radius-sm); padding:0.5rem 0.75rem;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="font-monospace fw-bold" style="color:{{ task.color }}; font-size:0.82rem;">{{ key }}</span>
                        {% set setting_runs = runs|selectattr('setting', 'equalto', key)|list if runs else [] %}
                        {% if setting_runs %}
                            <span class="badge bg-success" style="font-size:0.6rem;">{{ setting_runs|length }} run{{ 's' if setting_runs|length > 1 }}</span>
                        {% else %}
                            <span class="badge bg-secondary" style="font-size:0.6rem;">No runs</span>
                        {% endif %}
                    </div>
                    <div style="font-size:0.78rem; color:var(--text-muted);">{{ s.description }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="dash-card h-100">
            <h6 style="color:var(--text-bright); font-weight:700; margin-bottom:0.75rem;">
                <i class="fas fa-ruler me-2" style="opacity:0.5;"></i>Default Metrics
            </h6>
            {% if task.default_metrics %}
            <div class="d-flex flex-column gap-1">
                {% for m in task.default_metrics %}
                {% set meta = metric_meta.get(m) %}
                <div class="d-flex justify-content-between align-items-center" style="font-size:0.82rem; padding:0.25rem 0; border-bottom:1px solid var(--border-soft);">
                    <span style="color:var(--text-main);">{{ meta[0] if meta else m }}</span>
                    <div class="d-flex align-items-center gap-2">
                        {% if meta and meta[1] %}<span class="text-muted" style="font-size:0.72rem;">{{ meta[1] }}</span>{% endif %}
                        {% if meta %}<span style="font-size:0.68rem;" class="{{ 'text-success' if meta[2] else 'text-info' }}">{{ 'lower better' if meta[2] else 'higher better' }}</span>{% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}<p class="text-muted" style="font-size:0.82rem;">Depends on sub-task</p>{% endif %}
        </div>
    </div>
    <div class="col-md-3">
        <div class="dash-card h-100">
            <h6 style="color:var(--text-bright); font-weight:700; margin-bottom:0.75rem;">
                <i class="fas fa-chart-pie me-2" style="opacity:0.5;"></i>Status
            </h6>
            <div class="d-flex flex-column gap-3">
                <div class="stat-box"><div class="stat-value" style="font-size:1.4rem;">{{ runs|length }}</div><div class="stat-label">Eval Runs</div></div>
                <div class="stat-box"><div class="stat-value" style="font-size:1.4rem;">{{ comp_table|length }}</div><div class="stat-label">Model/Setting Combos</div></div>
                <div class="stat-box"><div class="stat-value" style="font-size:1.4rem;">{{ baselines|length }}</div><div class="stat-label">Baselines</div></div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- Sample Browser: viewer + sample list side by side          -->
<!-- ═══════════════════════════════════════════════════════════ -->
{% if runs %}
<h5 class="section-title"><i class="fas fa-play-circle"></i>Sample Browser</h5>
<div class="dash-card mb-4">
    <!-- Setting tabs (populated by JS) -->
    <div class="d-flex gap-1 mb-3" id="settingTabs" style="display:none;">
        <label style="font-size:0.82rem; color:var(--text-muted); font-weight:600; white-space:nowrap; align-self:center;">Setting:</label>
    </div>

    <!-- Model selector + controls -->
    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <label style="font-size:0.82rem; color:var(--text-muted); font-weight:600; white-space:nowrap;">Model:</label>
        <select id="runSelect" class="form-select" style="max-width:300px;" onchange="switchRun()">
            {# Populated by JS based on selected setting #}
        </select>
        <!-- Text-conditioning badge: shows whether the currently selected
             model+task combo actually uses caption input at inference. Set
             by switchRun() / renderSampleList. -->
        <span id="captionBadge" style="display:none; font-size:0.72rem; padding:3px 8px; border-radius:999px; border:1px solid; white-space:nowrap;"></span>
        <div class="d-flex gap-1 align-items-center">
            <button class="btn btn-sm btn-outline-secondary sample-nav-btn" onclick="prevSample()" title="Previous (&#8592;)"><i class="fas fa-chevron-left"></i></button>
            <span class="font-monospace" style="font-size:0.82rem; color:var(--text-bright); min-width:70px; text-align:center;" id="sampleCounter">0 / 0</span>
            <button class="btn btn-sm btn-outline-secondary sample-nav-btn" onclick="nextSample()" title="Next (&#8594;)"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div class="ms-auto d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" id="btnRandom" onclick="randomSample()" title="Jump to random unviewed sample"><i class="fas fa-shuffle"></i> Random</button>
            <button class="btn btn-sm btn-outline-secondary btn-compare" id="btnCompare" onclick="toggleCompareMode()" title="Compare all models in this setting"><i class="fas fa-columns"></i> Compare</button>
            {% if task.task_id == 'E9' %}
            <button class="btn btn-sm btn-outline-warning" id="btnLQOverlay" onclick="toggleLQOverlay()" title="Show/hide the low-quality (defective) source motion as a red SMPL mesh placed to the left of the repair output">
                <i class="fas fa-eye-slash"></i> LQ mesh
            </button>
            {% endif %}
            <a id="fullViewerLink" href="/viewer" target="_blank" class="btn btn-sm btn-outline-secondary" title="Open in full 3D viewer"><i class="fas fa-expand"></i></a>
        </div>
    </div>

    <!-- Normal single-viewer mode -->
    <div id="singleViewerMode">
        <div class="row g-3">
            <!-- Left: viewer + controls (full width top) -->
            <div class="col-12">
                <!-- Caption -->
                <div id="captionBar" class="mb-2" style="min-height:24px; display:none; background:rgba(59,130,246,0.08); border:1px solid rgba(59,130,246,0.2); border-radius:6px; padding:6px 10px;">
                    <i class="fas fa-quote-left me-1" style="opacity:0.4; font-size:0.7rem; color:#3b82f6;"></i>
                    <span id="sampleCaption" style="font-size:0.85rem; color:var(--text-bright); font-style:italic;"></span>
                    <button id="btnRewriteCaption" class="btn btn-sm btn-outline-primary ms-2" style="font-size:0.7rem; padding:1px 6px; display:none;" onclick="rewriteCaption()" title="Rewrite caption to English motion description">
                        <i class="fas fa-language me-1"></i>Rewrite
                    </button>
                    <span id="rewrittenCaption" style="font-size:0.82rem; color:#10b981; display:none; margin-left:8px;"></span>
                </div>

                <!-- E9 Quality-check diff panel: defect list (from quality checker)
                     + count of "defective" frames (adaptive mask positives) -->
                <div id="e9QcPanel" class="mb-2" style="display:none; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.25); border-radius:6px; padding:6px 10px; font-size:0.82rem;">
                    <span style="color:#ef4444; font-weight:600;"><i class="fas fa-bug me-1"></i>QC diagnosis:</span>
                    <span id="e9DefectList" style="color:var(--text-bright); margin-left:4px;">—</span>
                    <span style="margin-left:12px; color:var(--text-muted);">Defective frames:</span>
                    <span id="e9DefectFrames" style="color:#ef4444; font-weight:600;">—</span>
                    <br>
                    <span style="color:#ef4444;"><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#ef4444;margin-right:3px;"></span>LQ input mesh (left, red)</span>
                    <span style="margin-left:8px; color:#fbbf24;"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#fbbf24;margin-right:3px;"></span>Joints to be modified by repair (adaptive mask)</span>
                    <span style="margin-left:8px; color:#f59e0b;"><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#f59e0b;margin-right:3px;"></span>Repaired output mesh (right)</span>
                </div>
                <!-- Canvas -->
                <div id="smplViewer" class="viewer-canvas"></div>
                <!-- Playback controls -->
                <div class="d-flex align-items-center gap-2 mt-2">
                    <button class="btn btn-sm btn-outline-secondary" id="btnFramePlay" onclick="toggleFramePlay()">
                        <i class="fas fa-play" id="framePlayIcon"></i>
                    </button>
                    <input type="range" id="frameSlider" min="0" max="0" value="0" style="flex:1; accent-color:var(--bg-accent);" oninput="seekFrame(this.value)">
                    <span class="font-monospace text-muted" style="font-size:0.78rem; min-width:70px;" id="frameInfo">0 / 0</span>
                </div>
                <!-- Mask visualization bar -->
                <div id="maskBarContainer" style="display:none; margin-top:4px;">
                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:2px;">
                        <canvas id="maskBar" style="flex:1; height:10px; border-radius:3px; cursor:pointer;" onclick="onMaskBarClick(event)"></canvas>
                    </div>
                    <div style="display:flex; gap:12px; font-size:0.68rem; color:var(--text-muted); flex-wrap:wrap;">
                        <span id="legendC"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#3b82f6;margin-right:3px;"></span>Condition (input)</span>
                        <span id="legendG"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#f59e0b;margin-right:3px;"></span>Generated</span>
                        <span id="legendN" style="display:none;"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#9ca3af;margin-right:3px;"></span>Not Input</span>
                        <span id="maskFrameLabel" class="font-monospace" style="margin-left:auto;"></span>
                    </div>
                </div>
                <!-- End-effector / foot constraint info panel (E4, E6) -->
                <div id="constraintInfoPanel" style="display:none; margin-top:6px; padding:8px 12px; background:rgba(239,68,68,0.06); border:1px solid rgba(239,68,68,0.18); border-radius:6px; font-size:0.78rem;">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                        <i class="fas fa-crosshairs" style="color:#ef4444; font-size:0.8rem;"></i>
                        <strong id="constraintTitle" style="color:var(--text-bright);"></strong>
                    </div>
                    <div id="constraintDetails" style="display:flex; flex-wrap:wrap; gap:12px; color:var(--text-muted);">
                    </div>
                    <div id="constraintJointLegend" style="display:flex; flex-wrap:wrap; gap:10px; margin-top:5px;">
                    </div>
                </div>
            </div>
            <!-- Bottom: sample list + metrics side by side -->
            <div class="col-lg-7">
                <div class="sample-sidebar" id="sampleList">
                    <!-- Populated by JS -->
                </div>
            </div>
            <div class="col-lg-5">
                <!-- Per-sample metrics -->
                <div id="sampleMetrics" style="font-size:0.78rem;"></div>
            </div>
        </div>
    </div>

    <!-- Compare mode (hidden by default) -->
    <div id="compareViewerMode" style="display:none;">
        <!-- Caption (shared) -->
        <div class="mb-2" style="min-height:24px;">
            <i class="fas fa-quote-left me-1" style="opacity:0.2; font-size:0.7rem;"></i>
            <span id="compareSampleCaption" style="font-size:0.85rem; color:var(--text-main);"></span>
        </div>
        <!-- Viewer grid -->
        <div class="compare-grid cols-2" id="compareGrid">
            <!-- Dynamically populated -->
        </div>
        <!-- Shared playback controls -->
        <div class="d-flex align-items-center gap-2 mt-2">
            <button class="btn btn-sm btn-outline-secondary" id="btnCompareFramePlay" onclick="toggleCompareFramePlay()">
                <i class="fas fa-play" id="compareFramePlayIcon"></i>
            </button>
            <input type="range" id="compareFrameSlider" min="0" max="0" value="0" style="flex:1; accent-color:var(--bg-accent);" oninput="seekCompareFrame(this.value)">
            <span class="font-monospace text-muted" style="font-size:0.78rem; min-width:70px;" id="compareFrameInfo">0 / 0</span>
        </div>
        <!-- Compare mask bar -->
        <div id="compareMaskBarContainer" style="display:none; margin-top:4px;">
            <div style="display:flex; align-items:center; gap:6px; margin-bottom:2px;">
                <canvas id="compareMaskBar" style="flex:1; height:10px; border-radius:3px; cursor:pointer;" onclick="onCompareMaskBarClick(event)"></canvas>
            </div>
            <div style="display:flex; gap:12px; font-size:0.68rem; color:var(--text-muted); flex-wrap:wrap;">
                <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#3b82f6;margin-right:3px;"></span>Condition (input)</span>
                <span><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#f59e0b;margin-right:3px;"></span>Generated</span>
                <span id="compareLegendN" style="display:none;"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#9ca3af;margin-right:3px;"></span>Not Input</span>
                <span id="compareMaskFrameLabel" class="font-monospace" style="margin-left:auto;"></span>
            </div>
        </div>
        <!-- Sample list for compare mode -->
        <div class="row g-3 mt-2">
            <div class="col-lg-7">
                <div class="sample-sidebar" id="compareSampleList"></div>
            </div>
            <div class="col-lg-5">
                <div id="compareSampleMetrics" style="font-size:0.78rem;"></div>
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Test Data Distribution -->
<div class="dash-card mb-4" id="distSection" style="display:none;">
    <h6 style="color:var(--text-bright); font-weight:700; margin-bottom:0.75rem;">
        <i class="fas fa-chart-pie me-2" style="opacity:0.5;"></i>Test Data Distribution
        <span class="text-muted fw-normal ms-2" style="font-size:0.78rem;" id="distTotalLabel"></span>
    </h6>
    <div class="row g-3">
        <div class="col-md-5">
            <canvas id="distPieChart" style="max-height:260px;"></canvas>
            <div id="pieFilterBadge" style="display:none; margin-top:8px; text-align:center;">
                <span class="pie-filter-badge">
                    <i class="fas fa-filter" style="font-size:0.7rem; opacity:0.6;"></i>
                    <span id="pieFilterLabel">Filtered</span>
                    <span class="clear-btn" onclick="clearPieFilter()" title="Clear filter">&times;</span>
                </span>
            </div>
        </div>
        <div class="col-md-7">
            <div style="max-height:280px; overflow-y:auto;">
                <table class="table table-dash mb-0" style="font-size:0.78rem;">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-center">Count</th>
                            <th class="text-center">%</th>
                            <th class="text-center">Actions</th>
                            <th>Examples (EN)</th>
                        </tr>
                    </thead>
                    <tbody id="distTableBody"></tbody>
                </table>
            </div>
            <div id="distFrameStats" class="mt-2" style="font-size:0.75rem; color:var(--text-muted);"></div>
        </div>
    </div>
</div>

{% if rerunning_entries %}
<div class="alert alert-warning py-2 px-3 mb-3" style="font-size:0.85rem;">
    <i class="fas fa-hourglass-half me-1"></i>
    <strong>Inference in progress</strong> — the following (model, setting) results are stale and hidden from charts; a fresh run is underway:
    <div class="mt-1" style="font-size:0.78rem;">
        {% for e in rerunning_entries %}
        <span class="badge bg-warning-subtle text-warning-emphasis me-1" style="font-weight:500;">
            {{ e.model_name }} / {{ e.setting }} <i class="fas fa-spinner fa-spin ms-1"></i>
        </span>
        {% endfor %}
    </div>
</div>
{% endif %}

{% if comp_table %}
<!-- Metrics Comparison Table -->
<h5 class="section-title"><i class="fas fa-table"></i>Metrics Comparison</h5>
<div class="dash-card mb-4" style="overflow-x:auto;">
    <table class="table table-dash mb-0" id="metricsTable">
        <thead>
            <tr>
                <th style="min-width:180px;">Model (Setting)</th>
                {% for metric in sorted_metrics %}
                <th class="text-center">
                    {{ metric_meta.get(metric, (metric,'',true))[0] if metric in metric_meta else metric }}
                    {% if metric in metric_meta %}<br><small class="text-muted fw-normal">{{ metric_meta[metric][1] }}</small>{% endif %}
                </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for key, entry in comp_table.items() %}
            <tr>
                <td>
                    <strong>{{ entry.model_name }}</strong> <span class="text-muted">({{ entry.setting }})</span>
                    {% if entry.get('is_baseline') %}<span class="badge bg-warning text-dark" style="font-size:0.65rem;">BASELINE</span>{% endif %}
                    {% if entry.get('skeleton_type') and entry.skeleton_type != 'smpl22' %}<span class="skeleton-badge skeleton-soma">{{ entry.skeleton_type }}</span>{% endif %}
                </td>
                {% for metric in sorted_metrics %}
                {% set val = entry.metrics.get(metric, {}) %}
                {% if val and val.get('mean') is not none %}
                <td class="text-center font-monospace">
                    {{ val.mean|fmt_metric(metric) }}
                    {% if val.get('std') is not none %}<br><small class="text-muted">&plusmn;{{ val.std|fmt_metric(metric) }}</small>{% endif %}
                </td>
                {% else %}<td class="text-center text-muted">-</td>{% endif %}
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Charts -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="chart-container">
            <h6 style="color:var(--text-bright); font-weight:700; margin-bottom:0.75rem;"><i class="fas fa-chart-bar me-2" style="opacity:0.5;"></i>Key Metrics Comparison</h6>
            <canvas id="barChart"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="chart-container">
