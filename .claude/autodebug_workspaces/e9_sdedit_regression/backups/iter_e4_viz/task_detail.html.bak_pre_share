async function rebuildCompareViewers() {
    cleanupCompareViewers();
    const grid = document.getElementById('compareGrid');
    const n = compareSelectedRuns.length;
    if (n === 0) return;

    // Set grid columns
    grid.className = `compare-grid cols-${Math.min(n, 4)}`;

    // Fetch samples for all selected runs
    const samplePromises = compareSelectedRuns.map(r =>
        fetch(`/api/runs/${r.runId}/samples?offset=0&limit=9999`)
            .then(res => res.ok ? res.json() : {samples: []})
            .catch(() => ({samples: []}))
    );
    const allResults = await Promise.all(samplePromises);
    compareSamples = {};
    compareSelectedRuns.forEach((r, i) => {
        const byPrompt = {};
        const result = allResults[i] || {};
        (result.samples || []).forEach(s => { byPrompt[s.prompt_id] = s; });
        compareSamples[r.runId] = byPrompt;
    });

    // Find common prompt_ids across all selected runs
    const allPromptSets = compareSelectedRuns.map(r => new Set(Object.keys(compareSamples[r.runId])));
    let commonPrompts = [...allPromptSets[0]];
    for (let i = 1; i < allPromptSets.length; i++) {
        commonPrompts = commonPrompts.filter(p => allPromptSets[i].has(p));
    }
    commonPrompts.sort();

    // Build compare sample list
    const listDiv = document.getElementById('compareSampleList');
    let listHtml = '';
    commonPrompts.forEach((pid, i) => {
        const s = compareSamples[compareSelectedRuns[0].runId][pid];
        const caption = (s.text_caption || '').substring(0, 50);
        listHtml += `<div class="sample-list-item ${i === 0 ? 'active' : ''}" onclick="goToCompareSample(${i})" id="csli-${i}">
            <div class="d-flex justify-content-between">
                <span><strong class="font-monospace" style="font-size:0.72rem;">${pid}</strong></span>
                <span class="text-muted" style="font-size:0.7rem;">#${i}</span>
            </div>
            <div style="color:var(--text-muted); font-size:0.72rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${caption}</div>
        </div>`;
    });
    listDiv.innerHTML = listHtml;

    // Create viewer cells
    for (let i = 0; i < n; i++) {
        const r = compareSelectedRuns[i];
        const cell = document.createElement('div');
        cell.className = 'compare-viewer-cell';
        cell.innerHTML = `<div class="compare-viewer-label">${r.model} (${r.setting})</div><div id="cviewer-${i}" class="viewer-canvas"></div>`;
        grid.appendChild(cell);
    }

    // Initialize Three.js for each viewer
    await new Promise(resolve => setTimeout(resolve, 50)); // let DOM settle
    for (let i = 0; i < n; i++) {
        const container = document.getElementById(`cviewer-${i}`);
        if (!container) continue;

        const vScene = new THREE.Scene();
        vScene.background = new THREE.Color(0x080a10);
        const w = container.clientWidth, h = container.clientHeight;
        const vCamera = new THREE.PerspectiveCamera(45, w / h, 0.1, 100);
        vCamera.position.set(0, 1, 4);
        const vRenderer = new THREE.WebGLRenderer({ antialias: true });
        vRenderer.setSize(w, h);
        vRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        vRenderer.shadowMap.enabled = true;
        container.appendChild(vRenderer.domElement);
        const vOrbit = new OrbitControls(vCamera, vRenderer.domElement);
        vOrbit.enableDamping = true;
        vOrbit.target.set(0, 0.9, 0);

        vScene.add(new THREE.AmbientLight(0xffffff, 0.5));
        const dir = new THREE.DirectionalLight(0xffffff, 0.9);
        dir.position.set(3, 8, 5); dir.castShadow = true;
        vScene.add(dir);
        vScene.add(new THREE.DirectionalLight(0x8899bb, 0.3).translateX(-3).translateY(2).translateZ(-3));
        const ground = new THREE.Mesh(new THREE.PlaneGeometry(10, 10), new THREE.MeshStandardMaterial({ color: 0x111318, roughness: 0.95 }));
        ground.rotation.x = -Math.PI / 2; ground.receiveShadow = true;
        vScene.add(ground);
        const vGrid = new THREE.GridHelper(10, 20, 0x1e2230, 0x1e2230);
        vGrid.material.opacity = 0.4; vGrid.material.transparent = true;
        vScene.add(vGrid);

        const viewer = {
            scene: vScene, camera: vCamera, renderer: vRenderer, orbitCtrl: vOrbit,
            smplMesh: null, smplBones: null, smplSkeleton: null, smplEdges: null,
            smplData: null, skeletonGroup: null, skeletonData: null,
            meshSeqMesh: null, meshSeqData: null, meshSeqDecoded: null, renderMode: 'smpl',
            runId: compareSelectedRuns[i].runId, container: container, animId: null,
        };
        compareViewers.push(viewer);

        // Render loop
        function rl() {
            viewer.animId = requestAnimationFrame(rl);
            vOrbit.update();
            vRenderer.render(vScene, vCamera);
        }
        rl();

        // Camera sync: when user drags viewer i, sync all others
        vOrbit.addEventListener('change', () => {
            if (!ComparisonController.syncCameras) return;
            compareViewers.forEach((other, j) => {
                if (j === i) return;
                ComparisonController.syncCamera(vOrbit, vCamera, other.orbitCtrl, other.camera);
            });
        });
    }

    // Store commonPrompts for navigation
    window._comparePrompts = commonPrompts;
    window._compareIdx = 0;

    // Load first sample
    if (commonPrompts.length > 0) loadCompareSample(0);
}

let _compareIdx = 0;
function goToCompareSample(idx) {
    const prompts = window._comparePrompts || [];
    if (idx < 0 || idx >= prompts.length) return;
    if (compareSelectedRuns.length === 0) return;
    // Deactivate old
    const oldEl = document.getElementById(`csli-${window._compareIdx}`);
    if (oldEl) oldEl.classList.remove('active');
    window._compareIdx = idx;
    const newEl = document.getElementById(`csli-${idx}`);
    if (newEl) { newEl.classList.add('active'); newEl.scrollIntoView({ block: 'nearest' }); }
    // Update counter
    document.getElementById('sampleCounter').textContent = `${idx + 1} / ${prompts.length}`;
    loadCompareSample(idx);
}

async function loadCompareSample(idx) {
    const prompts = window._comparePrompts || [];
    const pid = prompts[idx];
    if (!pid || compareSelectedRuns.length === 0) return;

    // Show caption from first run
    const firstRunSamples = compareSamples[compareSelectedRuns[0].runId];
    const firstSample = firstRunSamples ? firstRunSamples[pid] : null;
    document.getElementById('compareSampleCaption').textContent = firstSample ? (firstSample.text_caption || '(no caption)') : '';

    if (compareFramePlaying) toggleCompareFramePlay();
    const thisLoad = ++compareLoadGen;

    // For stitched tasks (E14/15/16), prefetch the source motions once — all
    // viewers share the same source pair for a given prompt_id.
    let sourceMotionData = null;
    if ((TASK_ID === 'E14') && pid) {
        try {
            const srcResp = await fetch(`/api/source_motions/${TASK_ID}/${pid}`);
            if (thisLoad !== compareLoadGen) return;
            if (srcResp.ok) sourceMotionData = await srcResp.json();
        } catch(e) { /* continue without source motions */ }
        if (thisLoad !== compareLoadGen) return;
    }

    let maxFrames = 0;

    for (let vi = 0; vi < compareViewers.length; vi++) {
        const v = compareViewers[vi];
        const r = compareSelectedRuns[vi];
        if (!r) continue;
        const runSamples = compareSamples[r.runId];
        const sample = runSamples ? runSamples[pid] : null;
        if (!sample) continue;

        // Use gen_motion_path from DB (reliable), fallback to npzDir construction
        const npzPath = sample.gen_motion_path
            || (r.npzDir ? `${r.npzDir}/${pid}.npz` : '');
        if (!npzPath) continue;

        // Cleanup old meshes in this viewer
        if (v.smplMesh && v.scene) { v.scene.remove(v.smplMesh); v.smplMesh.geometry.dispose(); v.smplMesh.material.dispose(); v.smplMesh = null; v.smplBones = null; v.smplSkeleton = null; }
        if (v.skeletonGroup && v.scene) { v.scene.remove(v.skeletonGroup); v.skeletonGroup = null; }
        if (v.meshSeqMesh && v.scene) { v.scene.remove(v.meshSeqMesh); v.meshSeqMesh.geometry.dispose(); v.meshSeqMesh.material.dispose(); v.meshSeqMesh = null; }
        v.smplData = null; v.skeletonData = null; v.meshSeqData = null;
        v.sourceMotionCtx = null;

        const smplUrl = `/api/smpl/${npzPath.replace(/^\/+/, '')}?rotation_space=${r.rotation}`;
        const posUrl = `/api/npz/${npzPath.replace(/^\/+/, '')}`;

        try {
            // Strategy: load skeleton FIRST (fast ~20ms), then upgrade to SMPL in background
            const posResp = await fetch(posUrl);
            if (thisLoad !== compareLoadGen) return;
            const posData = await posResp.json();
            if (thisLoad !== compareLoadGen) return;

            if (posData && !posData.error) {
                // For stitched tasks, prepend/append grayed-out source motion.
                if (sourceMotionData) {
                    const ctx = stitchSourceMotionsGeneric(posData, null, sourceMotionData, TASK_ID);
                    if (ctx) v.sourceMotionCtx = ctx;
                }
                v.renderMode = 'skeleton';
                v.skeletonData = posData;
                compareLoadSkeleton(v, posData);
                if (posData.num_frames > maxFrames) maxFrames = posData.num_frames;

                // Compute per-viewer ground offset from skeleton world positions
                // so feet sit on Y=0 (matches single-viewer canonicalizeGround).
                // Without this, Compare mode renders motions at their raw
                // pelvis Y (~0.9m) and the characters appear to float.
                let vMinY = Infinity;
                const positions = posData.positions;
                if (positions) {
                    for (let f = 0; f < positions.length; f++) {
                        for (let j = 0; j < positions[f].length; j++) {
                            const y = positions[f][j][1];
                            if (y < vMinY) vMinY = y;
                        }
                    }
                }
                v.groundOffset = (vMinY !== Infinity) ? -vMinY : 0;
                if (v.skeletonGroup) v.skeletonGroup.position.y = v.groundOffset;
                if (v.smplMesh)      v.smplMesh.position.y      = v.groundOffset;
                if (v.meshSeqMesh)   v.meshSeqMesh.position.y   = v.groundOffset;
            }

            // Upgrade to SMPL mesh in background (non-blocking)
            fetch(smplUrl).then(r2 => r2.json()).then(async data => {
                if (thisLoad !== compareLoadGen) return;
                if (data.error) return;
                if (data.type === 'mesh_sequence') {
                    v.renderMode = 'mesh_seq';
                    v.meshSeqData = data;
                    if (v.skeletonGroup && v.scene) v.skeletonGroup.visible = false;
                    compareLoadMeshSequence(v, data);
                    // Apply the ground offset that was computed from skeleton data
                    if (v.meshSeqMesh) v.meshSeqMesh.position.y = v.groundOffset || 0;
                } else if (data.frames) {
                    try {
                        v.renderMode = 'smpl';
                        if (v.skeletonGroup && v.scene) v.skeletonGroup.visible = false;
                        await compareLoadSMPLMesh(v, data);
                        if (thisLoad !== compareLoadGen) return;
                        v.smplData = data;
                        // Apply ground offset to the new SMPL mesh
                        if (v.smplMesh) v.smplMesh.position.y = v.groundOffset || 0;
                        // Re-stitch to include prefix/suffix SMPL frames; idempotent.
                        if (sourceMotionData) {
                            const ctx2 = stitchSourceMotionsGeneric(posData, v.smplData, sourceMotionData, TASK_ID);
                            if (ctx2) v.sourceMotionCtx = ctx2;
                        }
                    } catch(e) {
                        v.renderMode = 'skeleton';
                        if (v.skeletonGroup) v.skeletonGroup.visible = true;
                    }
                }
                drawCompareFrame();
            }).catch(() => {});
        } catch(e) {
            console.warn(`Compare load failed for viewer ${vi}:`, e);
        }
    }

    compareCurrentFrame = 0;
    document.getElementById('compareFrameSlider').max = Math.max(maxFrames - 1, 0);
    document.getElementById('compareFrameSlider').value = 0;
    renderCompareMaskBar(maxFrames);
    drawCompareFrame();
    if (!compareFramePlaying) toggleCompareFramePlay();
}

function compareLoadMeshSequence(v, data) {
    if (v.meshSeqMesh) { v.scene.remove(v.meshSeqMesh); v.meshSeqMesh.geometry.dispose(); v.meshSeqMesh.material.dispose(); }
    let posArr, idxArr, nVerts;
    if (data.vertices_b64) {
        const dec = decodeMeshB64(data);
        v.meshSeqDecoded = dec;
        nVerts = dec.numVerts;
        posArr = new Float32Array(dec.allVerts.buffer, 0, nVerts * 3);
        idxArr = new Uint32Array(dec.facesFlat.buffer);
    } else {
        v.meshSeqDecoded = null;
        const faces = data.faces;
        const verts0 = data.vertices[0];
        nVerts = verts0.length;
        posArr = new Float32Array(nVerts * 3);
        for (let i = 0; i < nVerts; i++) { posArr[i*3] = verts0[i][0]; posArr[i*3+1] = verts0[i][1]; posArr[i*3+2] = verts0[i][2]; }
        idxArr = new Uint32Array(faces.length * 3);
        for (let i = 0; i < faces.length; i++) { idxArr[i*3] = faces[i][0]; idxArr[i*3+1] = faces[i][1]; idxArr[i*3+2] = faces[i][2]; }
    }
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(posArr.slice(), 3));
    geometry.setIndex(new THREE.BufferAttribute(idxArr, 1));
    geometry.computeVertexNormals();
    const material = new THREE.MeshStandardMaterial({ color: 0x06b6d4, side: THREE.DoubleSide, roughness: 0.6, metalness: 0.05, flatShading: false, emissive: 0x111111, emissiveIntensity: 0.15 });
    v.meshSeqMesh = new THREE.Mesh(geometry, material);
    v.meshSeqMesh.castShadow = true;
    v.scene.add(v.meshSeqMesh);
}

async function compareLoadSMPLMesh(v, smplParams) {
    if (v.smplMesh) { v.scene.remove(v.smplMesh); v.smplMesh.geometry.dispose(); v.smplMesh.material.dispose(); }
    const frame0 = smplParams.frames[0][0];
    const shapesArr = Array.isArray(frame0.shapes[0]) ? frame0.shapes[0] : frame0.shapes;
    const result = await load_smpl_with_shapes({
        shapes: shapesArr, gender: frame0.gender || 'neutral', poses: frame0.poses,
        Rh: frame0.Rh, Th: frame0.Th, smpl_type: frame0.smpl_type || 'smpl',
        framerate: frame0.mocap_framerate || 30,
    });
    v.smplMesh = result.mesh;
    v.smplBones = result.bones;
    v.smplSkeleton = result.skeleton;
    v.smplEdges = getEdgesForType(frame0.smpl_type || 'smpl');
    v.smplMesh.castShadow = true;
    v.scene.add(v.smplMesh);
    v.smplData = smplParams;
}

function compareLoadSkeleton(v, posData) {
    if (v.skeletonGroup) { v.scene.remove(v.skeletonGroup); }
    v.skeletonGroup = new THREE.Group();
    const numJ = posData.positions[0].length;
    const jointMat = new THREE.MeshStandardMaterial({ color: 0x06b6d4 });
    const boneMat = new THREE.MeshStandardMaterial({ color: 0x06b6d4, opacity: 0.7, transparent: true });
    for (let i = 0; i < numJ; i++) {
        const s = new THREE.Mesh(new THREE.SphereGeometry(0.012, 6, 6), jointMat);
        s.name = `sj_${i}`;
        v.skeletonGroup.add(s);
    }
    (posData.edges || []).forEach(([c, p], idx) => {
        const cyl = new THREE.Mesh(new THREE.CylinderGeometry(0.006, 0.006, 1, 4), boneMat);
        cyl.name = `sb_${idx}`;
        v.skeletonGroup.add(cyl);
    });
    v.scene.add(v.skeletonGroup);
}

function drawCompareFrame() {
    const isStitched = (TASK_ID === 'E14');
    compareViewers.forEach(v => {
        // Decide per-viewer effective render mode for stitched tasks:
        // prefer SMPL (stitched full-length, or network-only with local idx
        // mapping) → mesh_seq (only within network span) → skeleton (always
        // stitched full-length by stitchSourceMotionsGeneric).
        let effectiveMode = v.renderMode;
        let meshFrameIdx = compareCurrentFrame;
        let inNetwork = true;
        if (isStitched && v.sourceMotionCtx) {
            const { prefixLen, networkLen, suffixLen } = v.sourceMotionCtx;
            const networkStart = prefixLen || 0;
            const networkEnd = (prefixLen || 0) + (networkLen || 0);
            inNetwork = networkLen > 0
                ? (compareCurrentFrame >= networkStart && compareCurrentFrame < networkEnd)
                : false;
            const smplArrLen = v.smplData && v.smplData.frames ? v.smplData.frames.length : 0;
            const smplStitched = smplArrLen >= ((prefixLen || 0) + (networkLen || 0) + (suffixLen || 0));
            const smplReady = v.smplData && v.smplData.frames && (
                smplStitched
                    ? !!v.smplData.frames[compareCurrentFrame]
                    : (inNetwork && !!v.smplData.frames[compareCurrentFrame - networkStart])
            );
            const meshSeqAvailable = v.meshSeqData && v.meshSeqMesh;
            if (smplReady) {
                effectiveMode = 'smpl';
                meshFrameIdx = smplStitched
                    ? compareCurrentFrame
                    : (compareCurrentFrame - networkStart);
            } else if (meshSeqAvailable && inNetwork) {
                effectiveMode = 'mesh_seq';
                meshFrameIdx = compareCurrentFrame - networkStart;
                if (meshFrameIdx < 0) meshFrameIdx = 0;
                if (meshFrameIdx >= v.meshSeqData.num_frames) meshFrameIdx = v.meshSeqData.num_frames - 1;
            } else {
                effectiveMode = 'skeleton';
            }
            if (v.skeletonGroup) v.skeletonGroup.visible = (effectiveMode === 'skeleton');
            if (v.smplMesh) v.smplMesh.visible = (effectiveMode === 'smpl');
            if (v.meshSeqMesh) v.meshSeqMesh.visible = (effectiveMode === 'mesh_seq');
        }

        if (effectiveMode === 'smpl') drawCompareFrameSMPL(v, meshFrameIdx);
        else if (effectiveMode === 'skeleton') drawCompareFrameSkeleton(v);
        else if (effectiveMode === 'mesh_seq') drawCompareFrameMeshSeq(v, meshFrameIdx);

        // Color the mesh:
        //   - stitched tasks: gray outside network span, amber inside
        //   - non-stitched tasks: use compareFrameMask for region coloring
        let color, emissive;
        if (isStitched && v.sourceMotionCtx) {
            if (inNetwork) { color = 0xf59e0b; emissive = 0x4a3000; }
            else           { color = 0x9ca3af; emissive = 0x202020; }
        } else if (compareFrameMask && compareFrameMask.length > compareCurrentFrame) {
            const region = compareFrameMask[compareCurrentFrame];
            color = REGION_HEX[region] !== undefined ? REGION_HEX[region] : 0xf59e0b;
            emissive = REGION_EMISSIVE[region] !== undefined ? REGION_EMISSIVE[region] : 0x4a3000;
        }
        if (color !== undefined) {
            if (v.smplMesh && v.smplMesh.material) { v.smplMesh.material.color.setHex(color); v.smplMesh.material.emissive.setHex(emissive); }
            if (v.meshSeqMesh && v.meshSeqMesh.material) { v.meshSeqMesh.material.color.setHex(color); v.meshSeqMesh.material.emissive.setHex(emissive); }
        }
    });
    document.getElementById('compareFrameSlider').value = compareCurrentFrame;
    const maxNf = parseInt(document.getElementById('compareFrameSlider').max) + 1;
    document.getElementById('compareFrameInfo').textContent = `${compareCurrentFrame} / ${maxNf - 1}`;
    // Update mask label
    const lbl = document.getElementById('compareMaskFrameLabel');
    if (lbl && compareFrameMask && compareFrameMask.length > compareCurrentFrame) {
        const region = compareFrameMask[compareCurrentFrame];
        lbl.textContent = REGION_LABELS[region] || 'GEN';
        lbl.style.color = REGION_COLORS[region] || COLOR_GEN;
    }
}

function drawCompareFrameSMPL(v, frameIdxOverride) {
    if (!v.smplData || !v.smplBones) return;
    const idx = (frameIdxOverride !== undefined) ? frameIdxOverride : compareCurrentFrame;
    const frame = v.smplData.frames[idx];
    if (!frame || !frame[0]) return;
    const p = frame[0];
    const _axis = new THREE.Vector3();
    const _quat = new THREE.Quaternion();
    if (p.Rh && p.Rh[0]) {
        _axis.set(p.Rh[0][0], p.Rh[0][1], p.Rh[0][2]);
        const angle = _axis.length();
        if (angle > 1e-8) { _axis.normalize(); _quat.setFromAxisAngle(_axis, angle); } else _quat.identity();
        v.smplBones[0].quaternion.copy(_quat);
    }
    if (p.Th && p.Th[0]) v.smplBones[0].position.set(p.Th[0][0], p.Th[0][1], p.Th[0][2]);
    const poses = p.poses[0];
    const numJ = v.smplEdges ? v.smplEdges.length : 22;
    const off = (poses && poses.length === (numJ - 1) * 3) ? -3 : 0;
    for (let i = 1; i < numJ && i < v.smplBones.length; i++) {
        const base = off + 3 * i;
        if (base < 0 || base + 2 >= poses.length) continue;
        _axis.set(poses[base], poses[base+1], poses[base+2]);
        const angle = _axis.length();
        if (angle > 1e-8) { _axis.normalize(); _quat.setFromAxisAngle(_axis, angle); } else _quat.identity();
        v.smplBones[i].quaternion.copy(_quat);
    }
}

function drawCompareFrameSkeleton(v) {
    if (!v.skeletonData || !v.skeletonGroup) return;
    const pos = v.skeletonData.positions[compareCurrentFrame];
    if (!pos) return;
    updateSkeletonPositions(pos, v.skeletonData.edges, v.skeletonGroup);
}

function drawCompareFrameMeshSeq(v, frameIdxOverride) {
    if (!v.meshSeqData || !v.meshSeqMesh) return;
    const idx = (frameIdxOverride !== undefined) ? frameIdxOverride : compareCurrentFrame;
    const posAttr = v.meshSeqMesh.geometry.getAttribute('position');
    if (v.meshSeqDecoded) {
        const V = v.meshSeqDecoded.numVerts;
        const offset = idx * V * 3;
        const src = v.meshSeqDecoded.allVerts;
        for (let i = 0; i < V * 3; i++) posAttr.array[i] = src[offset + i];
    } else {
        const verts = v.meshSeqData.vertices[idx];
        if (!verts) return;
        for (let i = 0; i < verts.length; i++) posAttr.setXYZ(i, verts[i][0], verts[i][1], verts[i][2]);
    }
    posAttr.needsUpdate = true;
    v.meshSeqMesh.geometry.computeVertexNormals();
}

function seekCompareFrame(val) { compareCurrentFrame = parseInt(val); drawCompareFrame(); }

let lastCompareFrameTime = 0;
function compareFrameAnimate(time) {
    if (!compareFramePlaying) return;
    compareFrameAnimId = requestAnimationFrame(compareFrameAnimate);
    if (time - lastCompareFrameTime > 33) {
        const maxNf = parseInt(document.getElementById('compareFrameSlider').max) + 1;
        // E8 loop: skip last frame to avoid discontinuity
        const effectiveNf = (TASK_ID === 'E8' && maxNf > 2) ? maxNf - 1 : maxNf;
        compareCurrentFrame = (compareCurrentFrame + 1) % effectiveNf;
        drawCompareFrame();
        lastCompareFrameTime = time;
    }
}

function toggleCompareFramePlay() {
    compareFramePlaying = !compareFramePlaying;
    const icon = document.getElementById('compareFramePlayIcon');
    icon.classList.toggle('fa-play', !compareFramePlaying);
    icon.classList.toggle('fa-pause', compareFramePlaying);
    if (compareFramePlaying) { lastCompareFrameTime = performance.now(); requestAnimationFrame(compareFrameAnimate); }
    else if (compareFrameAnimId) cancelAnimationFrame(compareFrameAnimId);
}

document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
    if (e.key === 'ArrowLeft') { e.preventDefault(); prevSample(); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); nextSample(); }
    else if (e.key === ' ') { e.preventDefault(); compareMode ? toggleCompareFramePlay() : toggleFramePlay(); }
});

// Expose functions to global scope for inline onclick handlers
window.switchRun = switchRun;
window.goToSample = goToSample;
window.prevSample = prevSample;
window.nextSample = nextSample;
window.randomSample = randomSample;
window.filterAndRenderSamples = filterAndRenderSamples;
window.toggleFramePlay = toggleFramePlay;
window.seekFrame = seekFrame;
window.toggleCompareMode = toggleCompareMode;
window.toggleCompareRun = toggleCompareRun;
window.goToCompareSample = goToCompareSample;
window.toggleCompareFramePlay = toggleCompareFramePlay;
window.seekCompareFrame = seekCompareFrame;
</script>
