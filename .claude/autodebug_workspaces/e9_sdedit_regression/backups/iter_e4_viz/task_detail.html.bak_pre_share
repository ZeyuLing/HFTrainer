<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// ─── Test Data Distribution ─────────────────────────────────
const DIST_COLORS = [
    '#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899',
    '#06b6d4','#f97316','#14b8a6','#a855f7','#6366f1','#84cc16',
    '#e11d48','#0ea5e9','#d946ef','#22d3ee',
];

fetch('/api/datalist/{{ task.task_id }}')
    .then(r => r.ok ? r.json() : null)
    .then(meta => {
        if (!meta || !meta.category_distribution_detail) return;
        const section = document.getElementById('distSection');
        section.style.display = '';

        const dist = meta.category_distribution_detail;
        const cats = Object.keys(dist);
        const counts = cats.map(c => dist[c].count);
        const total = counts.reduce((a,b) => a+b, 0);

        document.getElementById('distTotalLabel').textContent = `${total} samples, ${cats.length} categories`;

        // Store category names globally for click filtering
        window._distCategories = cats;
        window._distChart = null;
        window._selectedPieCategory = null;

        // Pie chart
        const ctx = document.getElementById('distPieChart');
        window._distChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: cats,
                datasets: [{
                    data: counts,
                    backgroundColor: DIST_COLORS.slice(0, cats.length),
                    borderWidth: 0,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                const c = cats[ctx.dataIndex];
                                const d = dist[c];
                                return `${c}: ${d.count} (${d.percent}%, ${d.unique_actions} actions)`;
                            }
                        }
                    }
                },
                onClick: (event, elements) => {
                    if (!elements || !elements.length) {
                        clearPieFilter();
                        return;
                    }
                    const clickedCat = cats[elements[0].index];
                    if (window._selectedPieCategory === clickedCat) {
                        clearPieFilter();
                    } else {
                        applyPieFilter(clickedCat, elements[0].index);
                    }
                }
            }
        });

        // Table
        const tbody = document.getElementById('distTableBody');
        let html = '';
        cats.forEach((c, i) => {
            const d = dist[c];
            const exEn = (d.example_captions_en || []).slice(0, 2).join(', ');
            const color = DIST_COLORS[i % DIST_COLORS.length];
            html += `<tr>
                <td><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:${color};margin-right:6px;"></span>${c}</td>
                <td class="text-center font-monospace">${d.count}</td>
                <td class="text-center">${d.percent}%</td>
                <td class="text-center">${d.unique_actions}</td>
                <td style="color:var(--text-muted);max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${exEn}">${exEn}</td>
            </tr>`;
        });
        tbody.innerHTML = html;

        // Frame stats
        if (meta.frame_stats) {
            const fs = meta.frame_stats;
            document.getElementById('distFrameStats').textContent =
                `Frame stats: min=${fs.min}, max=${fs.max}, mean=${fs.mean}, median=${fs.median}`;
        }
    });

// ─── Pie chart click filtering ─────────────────────────────
function applyPieFilter(category, chartIndex) {
    window._selectedPieCategory = category;
    // Update badge
    const badge = document.getElementById('pieFilterBadge');
    const label = document.getElementById('pieFilterLabel');
    if (badge) badge.style.display = '';
    if (label) label.textContent = `${category}`;
    // Highlight selected sector in chart
    if (window._distChart) {
        const ds = window._distChart.data.datasets[0];
        const cats = window._distCategories || [];
        ds.borderWidth = cats.map((_, i) => i === chartIndex ? 3 : 0);
        ds.borderColor = cats.map((_, i) => i === chartIndex ? '#ffffff' : 'transparent');
        window._distChart.update();
    }
    // Filter sample list if it exists
    if (typeof filterAndRenderSamples === 'function') filterAndRenderSamples();
}
function clearPieFilter() {
    window._selectedPieCategory = null;
    const badge = document.getElementById('pieFilterBadge');
    if (badge) badge.style.display = 'none';
    // Reset chart highlighting
    if (window._distChart) {
        const ds = window._distChart.data.datasets[0];
        ds.borderWidth = 0;
        ds.borderColor = 'transparent';
        window._distChart.update();
    }
    if (typeof filterAndRenderSamples === 'function') filterAndRenderSamples();
}
window.applyPieFilter = applyPieFilter;
window.clearPieFilter = clearPieFilter;
</script>
<script type="module">
// ─── Chart data ──────────────────────────────────────────────
const compData = {{ comp_table|json_dumps|safe }};
const sortedMetrics = {{ sorted_metrics|json_dumps|safe }};
const metricMeta = {{ metric_meta|json_dumps|safe }};

// ─── All runs data (setting-aware) ──────────────────────────
const ALL_RUNS = [
    {% for run in runs %}
    { id: "{{ run.id }}", model: "{{ run.model_name }}", setting: "{{ run.setting }}",
      npzDir: "{{ run.result_json_path|replace('/result.json', '/npz') if run.result_json_path else '' }}",
      rotation: "{{ run.rotation_space or 'local' }}", samples: {{ run.num_samples }},
      epoch: {{ run.epoch or 0 }}, checkpoint: "{{ run.checkpoint_path or '' }}",
      hasCaption: {{ 'true' if run.has_caption else 'false' }} },
    {% endfor %}
];
// Task-level caption awareness (True if task benefits from text conditioning).
const TASK_CAPTION_AWARE = {{ 'true' if task.caption_aware else 'false' }};
const TASK_NEEDS_CAPTION = {{ 'true' if task.needs_caption else 'false' }};
function getRunsForSetting(s) { return ALL_RUNS.filter(r => r.setting === s); }
function getUniqueSettings() { return [...new Set(ALL_RUNS.map(r => r.setting))]; }

document.addEventListener('DOMContentLoaded', () => {
    if (Object.keys(compData).length > 0) {
        initBarChart('barChart', compData, sortedMetrics, metricMeta);
        initRadarGrid('radarGrid', compData, sortedMetrics, metricMeta);
        highlightBestMetrics();
    }
    // Auto-load: build setting tabs, pick first setting, populate dropdown
    if (ALL_RUNS.length > 0) {
        const settings = getUniqueSettings();
        const tabsDiv = document.getElementById('settingTabs');
        if (settings.length > 1) {
            tabsDiv.style.display = 'flex';
            settings.forEach((s, i) => {
                const btn = document.createElement('button');
                btn.className = i === 0 ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary';
                btn.dataset.setting = s;
                btn.textContent = s;
                btn.onclick = function() { switchSetting(s, this); };
                tabsDiv.appendChild(btn);
            });
        }
        currentSetting = settings[0];
        populateModelDropdown(currentSetting);
        switchRun();
    }
});

function highlightBestMetrics() {
    const table = document.getElementById('metricsTable');
    if (!table) return;
    const rows = table.querySelectorAll('tbody tr');
    if (rows.length < 2) return;
    for (let mi = 0; mi < sortedMetrics.length; mi++) {
        const meta = metricMeta[sortedMetrics[mi]];
        const lb = meta ? meta[2] : true;
        let best = null, cells = [];
        rows.forEach(row => {
            const cell = row.querySelectorAll('td')[mi + 1];
            if (!cell) return;
            const v = parseFloat(cell.textContent.trim().split('\n')[0].replace(/[^\d.\-e]/g, ''));
            if (isNaN(v)) return;
            if (best === null || (lb ? v < best : v > best)) { best = v; cells = [cell]; }
            else if (v === best) cells.push(cell);
        });
        cells.forEach(c => c.classList.add('metric-best'));
    }
}

// ─── Sample Browser ──────────────────────────────────────────
let allSamples = [];
let filteredSamples = []; // samples after category filter
let currentIdx = 0;
let currentNpzDir = '';
let currentRotSpace = 'local';
let currentSetting = '';
let motionData = null;
let framePlaying = false;
let frameAnimId = null;
let loadGeneration = 0; // monotonic counter to cancel stale loads
let viewedSet = new Set(); // track viewed samples for Random

// Source motion context for E14 (full original motions, grayed out)
let sourceMotionCtx = null; // {prefixPositions, suffixPositions, prefixLen, suffixLen, networkLen}

function switchSetting(setting, btnEl) {
    currentSetting = setting;
    // Update tab buttons
    document.querySelectorAll('#settingTabs button[data-setting]').forEach(b => {
        b.className = b.dataset.setting === setting ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary';
    });
    // If in compare mode, rebuild with new setting
    if (compareMode) {
        exitCompareMode();
        compareMode = true;
        document.getElementById('btnCompare').classList.add('active');
        document.getElementById('singleViewerMode').style.display = 'none';
        document.getElementById('compareViewerMode').style.display = '';
        // Auto-select all models in this setting
        const settingRuns = getRunsForSetting(setting);
        compareSelectedRuns = settingRuns.map(r => ({
            runId: r.id, npzDir: r.npzDir, model: r.model,
            setting: r.setting, rotation: r.rotation,
        }));
        rebuildCompareViewers();
    } else {
        // Update model dropdown for this setting
        populateModelDropdown(setting);
        switchRun();
    }
}
window.switchSetting = switchSetting;

function populateModelDropdown(setting) {
    const sel = document.getElementById('runSelect');
    const runs = getRunsForSetting(setting);
    sel.innerHTML = '';
    runs.forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.id;
        opt.dataset.npzdir = r.npzDir;
        opt.dataset.model = r.model;
        opt.dataset.setting = r.setting;
        opt.dataset.rotation = r.rotation;
        opt.dataset.samples = r.samples;
        const epochStr = r.epoch ? ` (ep${r.epoch})` : '';
        opt.textContent = `${r.model}${epochStr} — ${r.samples} samples`;
        sel.appendChild(opt);
    });
}

function switchRun() {
    const sel = document.getElementById('runSelect');
    const opt = sel.options[sel.selectedIndex];
    const runId = sel.value;
    currentNpzDir = opt.dataset.npzdir || '';
    currentRotSpace = opt.dataset.rotation || 'local';
    currentSetting = opt.dataset.setting || 'default';

    // Update the caption-conditioning badge so the user can tell at a glance
    // whether the currently-displayed run used caption as input or not.
    // Three states:
    //   - "Caption-conditioned": model has_caption AND task is caption_aware
    //     (or requires caption). Task actually fed caption to the model.
    //   - "Unconditioned": model has no caption support (uncond model) OR
    //     task is not caption_aware (e.g. E9 Motion Repair, E14 Transition).
    //     Even a caption model runs without caption here.
    //   - hidden: fallback if data missing.
    const runData = ALL_RUNS.find(r => String(r.id) === String(runId));
    const badge = document.getElementById('captionBadge');
    if (badge && runData) {
        const modelUsesCaption = !!runData.hasCaption;
        const taskUsesCaption = TASK_NEEDS_CAPTION || TASK_CAPTION_AWARE;
        const effectivelyCaption = modelUsesCaption && taskUsesCaption;
        if (effectivelyCaption) {
            badge.textContent = 'Caption-conditioned';
            badge.style.color = '#10b981';
            badge.style.borderColor = 'rgba(16,185,129,0.5)';
            badge.style.background = 'rgba(16,185,129,0.10)';
        } else {
            badge.textContent = 'Unconditional';
            badge.style.color = '#f59e0b';
            badge.style.borderColor = 'rgba(245,158,11,0.5)';
            badge.style.background = 'rgba(245,158,11,0.10)';
        }
        badge.style.display = '';
        badge.title = modelUsesCaption
            ? (taskUsesCaption
                ? 'Caption model on a caption-aware task → caption was fed to the model at inference.'
                : 'Caption model on a non-caption-aware task → caption was NOT used (task does not support text).')
            : 'Unconditional model → no caption input.';
    }

    // Force mesh/skeleton rebuild when switching models
    cleanupAllMeshes();

    // Load all samples for this run
    fetch(`/api/runs/${runId}/samples?offset=0&limit=9999`)
        .then(r => r.json())
        .then(data => {
            allSamples = data.samples || [];
            filteredSamples = getFilteredSamples();
            currentIdx = 0;
            viewedSet.clear();
            renderSampleList();
            if (filteredSamples.length > 0) {
                loadCurrentSample();
            } else {
                // No per-sample data — show message
                document.getElementById('sampleCounter').textContent = '0 / 0';
                document.getElementById('sampleCaption').textContent = '(no per-sample data for this run)';
                const viewerEl = document.getElementById('smplViewer');
                if (viewerEl) {
                    viewerEl.innerHTML = '';
                    viewerEl.style.position = 'relative';
                    const msg = document.createElement('div');
                    msg.className = 'no-viz-msg';
                    msg.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:var(--text-muted);font-size:0.9rem;text-align:center;z-index:5;';
                    msg.innerHTML = '<i class="fas fa-cube" style="font-size:2rem;opacity:0.3;display:block;margin-bottom:0.5rem;"></i>No per-sample visualization<br><small>Only aggregate metrics available. Switch Run to see a run with samples.</small>';
                    viewerEl.appendChild(msg);
                    // Reset Three.js so it reinits when a run with samples is selected
                    scene = null; rendererGL = null;
                }
            }
        });
}

function cleanupAllMeshes() {
    // Stop playback first
    if (framePlaying) toggleFramePlay();
    // Cleanup meshes
    if (smplMesh && scene) { scene.remove(smplMesh); smplMesh.geometry.dispose(); smplMesh.material.dispose(); smplMesh = null; smplBones = null; smplSkeleton = null; }
    if (skeletonGroup && scene) { scene.remove(skeletonGroup); skeletonGroup = null; }
    if (meshSeqMesh && scene) { scene.remove(meshSeqMesh); meshSeqMesh.geometry.dispose(); meshSeqMesh.material.dispose(); meshSeqMesh = null; }
    smplData = null; skeletonData = null; meshSeqData = null;
    sourceMotionCtx = null;
    groundOffset = 0;
    cleanupOverlays();
}

function getFilteredSamples() {
    const cat = window._selectedPieCategory;
    if (!cat) return allSamples;
    return allSamples.filter(s =>
        (s.category || '') === cat ||
        (s.defect_type || '') === cat ||
        (s.source_category || '') === cat
    );
}

function filterAndRenderSamples() {
    filteredSamples = getFilteredSamples();
    currentIdx = 0;
    renderSampleList();
    if (filteredSamples.length > 0) {
        loadCurrentSample();
    }
}
// Expose to non-module script
window.filterAndRenderSamples = filterAndRenderSamples;

function renderSampleList() {
    filteredSamples = getFilteredSamples();
    const container = document.getElementById('sampleList');
    let html = '';
    // Show filter info header when filtered
    const cat = window._selectedPieCategory;
    if (cat) {
        html += `<div class="mb-2 px-2" style="font-size:0.75rem; color:var(--text-muted);">
            <i class="fas fa-filter me-1" style="opacity:0.5;"></i>Showing <strong style="color:var(--text-bright);">${filteredSamples.length}</strong> of ${allSamples.length} samples in <strong style="color:var(--text-bright);">${cat}</strong>
            <a href="javascript:void(0)" onclick="clearPieFilter()" class="ms-2" style="font-size:0.72rem;">Clear</a>
        </div>`;
    }
    filteredSamples.forEach((s, i) => {
        const caption = (s.text_caption || '').substring(0, 50);
        const active = i === currentIdx ? 'active' : '';
        const catBadge = s.category ? `<span class="badge bg-secondary" style="font-size:0.6rem; margin-left:4px;">${s.category}</span>` : '';
        html += `<div class="sample-list-item ${active}" onclick="goToSample(${i})" id="sli-${i}">
            <div class="d-flex justify-content-between">
                <span><strong class="font-monospace" style="font-size:0.72rem;">${s.prompt_id || i}</strong>
                <span class="text-muted ms-1">${s.num_frames}f</span>${catBadge}</span>
                <span class="text-muted" style="font-size:0.7rem;">#${i}</span>
            </div>
            <div style="color:var(--text-muted); font-size:0.72rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${caption}</div>
        </div>`;
    });
    container.innerHTML = html;
    document.getElementById('sampleCounter').textContent = `${Math.min(currentIdx + 1, filteredSamples.length)} / ${filteredSamples.length}`;
}

function goToSample(idx) {
    if (idx < 0 || idx >= filteredSamples.length) return;
    // Deactivate old
    const oldEl = document.getElementById(`sli-${currentIdx}`);
    if (oldEl) oldEl.classList.remove('active');
    currentIdx = idx;
    viewedSet.add(idx);
    // Activate new
    const newEl = document.getElementById(`sli-${currentIdx}`);
    if (newEl) { newEl.classList.add('active'); newEl.scrollIntoView({ block: 'nearest' }); }
    document.getElementById('sampleCounter').textContent = `${currentIdx + 1} / ${filteredSamples.length}`;
    loadCurrentSample();
}

function prevSample() { compareMode ? goToCompareSample((window._compareIdx || 0) - 1) : goToSample(currentIdx - 1); }
function nextSample() { compareMode ? goToCompareSample((window._compareIdx || 0) + 1) : goToSample(currentIdx + 1); }

function randomSample() {
    // Handle compare mode separately
    if (compareMode) {
        const prompts = window._comparePrompts || [];
        if (prompts.length === 0) return;
        const pick = Math.floor(Math.random() * prompts.length);
        goToCompareSample(pick);
        return;
    }
    if (filteredSamples.length === 0) return;
    // Find unviewed samples
    let unviewed = [];
    for (let i = 0; i < filteredSamples.length; i++) {
        if (!viewedSet.has(i)) unviewed.push(i);
    }
    // Reset if all viewed
    if (unviewed.length === 0) {
        viewedSet.clear();
        unviewed = Array.from({length: filteredSamples.length}, (_, i) => i);
    }
    const pick = unviewed[Math.floor(Math.random() * unviewed.length)];
    goToSample(pick);
}

// ─── Per-frame mask computation (condition vs generated) ─────
const TASK_ID = '{{ task.task_id }}';
// 3-region color scheme: C=condition (input to network), G=generated (model output), N=not input
const COLOR_COND = '#3b82f6';   // blue — condition (input to network as mask=0)
const COLOR_GEN  = '#f59e0b';   // amber — generated (model fills this, mask=1)
const COLOR_N    = '#9ca3af';   // gray — not input to network at all
// Region codes: 0=C(condition), 1=G(generated), 2=N(not input)
const REGION_COLORS = { 0: COLOR_COND, 1: COLOR_GEN, 2: COLOR_N };
const REGION_HEX    = { 0: 0x3b82f6, 1: 0xf59e0b, 2: 0x9ca3af };
const REGION_EMISSIVE = { 0: 0x1a3a6b, 1: 0x4a3000, 2: 0x3a3f47 };
const REGION_LABELS = { 0: 'COND', 1: 'GEN', 2: 'N/A' };
let currentFrameMask = null; // Int8Array: 0=C, 1=G, 2=N

/**
 * Compute per-frame mask for the current task+setting+numFrames.
 * Returns Int8Array of length T:
 *   0 = C (condition — input to the network with mask=0, model sees this)
 *   1 = G (generated — model fills this, mask=1)
 *   2 = N (not input — frame is not part of network input at all)
 *
 * Note: In most tasks, all visualized frames are either condition or generated.
 * The "not input" category exists for cases where we display frames that the
 * network never sees (e.g., auxiliary context for visualization only).
 */
function computeFrameMask(T, taskId, setting) {
    // If source motions are stitched (E14), handle prefix/suffix as "Not Input"
    if (sourceMotionCtx && sourceMotionCtx.totalLen === T) {
        const { prefixLen, suffixLen, networkLen } = sourceMotionCtx;
        const mask = new Int8Array(T).fill(2); // default: not input (gray)
        // Compute network portion mask
        const networkMask = _computeNetworkMask(networkLen, taskId, setting);
        // Place network mask in the middle
        for (let i = 0; i < networkLen; i++) {
            mask[prefixLen + i] = networkMask[i];
        }
        return mask;
    }
    return _computeNetworkMask(T, taskId, setting);
}

/**
 * Compute mask for the network portion only (no prefix/suffix context).
 */
function _computeNetworkMask(T, taskId, setting) {
    const mask = new Int8Array(T).fill(1); // default: all generated

    if (taskId === 'E1' || taskId === 'E13') {
        // T2M / Multi-Prompt: pure generation, all frames generated
        return mask;
    }
    if (taskId === 'E2') {
        // In-betweening: keep first N and last M frames as condition
        if (setting === 'D') {
            // Transition stitching: A_tail=C, middle=G, B_head=C
            // Both sides are input to network as condition (mask=0)
            for (let i = 0; i < Math.min(15, T); i++) mask[i] = 0;       // C: A_tail
            for (let i = Math.max(0, T - 15); i < T; i++) mask[i] = 0;   // C: B_head
        } else {
            const ks = setting === 'C' ? 30 : 5;
            const ke = 5;
            for (let i = 0; i < Math.min(ks, T); i++) mask[i] = 0;
            for (let i = Math.max(0, T - ke); i < T; i++) mask[i] = 0;
        }
        return mask;
    }
    if (taskId === 'E3') {
        // Keyframe: keep every K-th frame as condition
        const K = setting === 'A' ? 30 : setting === 'B' ? 60 : setting === 'C' ? 15 : 30;
        for (let i = 0; i < T; i++) { if (i % K === 0) mask[i] = 0; }
        mask[T - 1] = 0; // always keep last
        return mask;
    }
    if (taskId === 'E7') {
        // First-frame continuation: frame 0 is condition
        if (T > 0) mask[0] = 0;
        // E7-C/D: also has a target frame (last or first) as condition
        if (setting === 'C' && T > 1) mask[T - 1] = 0; // target last frame = condition
        if (setting === 'D' && T > 1) mask[T - 1] = 0; // target first frame = condition
        return mask;
    }
    if (taskId === 'E8') {
        // Loop animation
        if (setting === 'D') {
            // Loop completion: given full GT motion of length T_gt, append
            // N_append=90 frames that end back at GT[0].
            //   frames [0 .. T_gt-1] = GT condition (mask=0, gray)
            //   frames [T_gt .. T-1] = generated tail (mask=1, yellow)
            //   frame  [T-1]         = anchored to GT[0] (also condition)
            // Here T = T_gt + 90, so T_gt = T - 90.
            const N_APPEND = 90;
            const T_gt = Math.max(0, T - N_APPEND);
            for (let i = 0; i < T_gt; i++) mask[i] = 0;   // C: GT context
            for (let i = T_gt; i < T; i++) mask[i] = 1;   // G: appended tail
            if (T > 0) mask[T - 1] = 0;                    // loop-target anchor
        } else {
            // Setting A: text→loop generation, first=last constraint
            // Both first and last are condition (mask=0)
            if (T > 0) { mask[0] = 0; mask[T - 1] = 0; }
        }
        return mask;
    }
    if (taskId === 'E9') {
        // Repair: editing mode, all frames are "condition" (input LQ motion)
        mask.fill(0);
        return mask;
    }
    if (taskId === 'E11') {
        // Caption completion: same mask pattern as E2/E3 + caption
        if (setting === 'inbetween') {
            for (let i = 0; i < Math.min(5, T); i++) mask[i] = 0;
            for (let i = Math.max(0, T - 5); i < T; i++) mask[i] = 0;
        } else {
            for (let i = 0; i < T; i++) { if (i % 30 === 0) mask[i] = 0; }
            mask[T - 1] = 0;
        }
        return mask;
    }
    if (taskId === 'E14') {
        // Transition stitching: A_tail=C, middle=G, B_head=C
        // Both A_tail and B_head are input to network as condition (mask=0)
        const nc = setting === 'A' ? 5 : setting === 'B' ? 15 : 30;
        for (let i = 0; i < Math.min(nc, T); i++) mask[i] = 0;           // C: A_tail
        for (let i = Math.max(0, T - nc); i < T; i++) mask[i] = 0;       // C: B_head
        return mask;
    }
    if (taskId === 'E15') {
        // E15 (2026-04-21 redefinition): prepend transition from start pose P.
        //   frame 0 = P (condition, mask=0)
        //   frames 1..N-1 = generated (mask=1)
        //   frames N..T-1 = A (condition, mask=0)
        // N per setting: A=30, B=60, C=90.
        const N = setting === 'A' ? 30 : setting === 'B' ? 60 : 90;
        if (T > 0) mask[0] = 0;                                           // C: P
        for (let i = 1; i < Math.min(N, T); i++) mask[i] = 1;             // G: transition
        for (let i = N; i < T; i++) mask[i] = 0;                          // C: A
        return mask;
    }
    // E4: End-effector constraints — show constraint frames as Condition
    if (taskId === 'E4') {
        // Map setting → frame interval (matches backend m2m_eval_tasks.py E4)
        let interval = 10;
        if (setting === 'A_rhand_sparse' || setting === 'D_both_hands') interval = 10;
        else if (setting === 'B_ankles_sparse' || setting === 'C_rhand_lfoot') interval = 15;
        else if (setting === 'E_all4_sparse') interval = 20;
        else if (setting === 'F_rhand_dense') interval = 5;
        for (let f = 0; f < T; f += interval) mask[f] = 0;  // C: constraint frames
        return mask;
    }
    // E6: Foot ground constraints — single setting pos_contact: ~GT contact frames
    if (taskId === 'E6') {
        // Without access to GT contact times client-side, use every-2-frame heuristic.
        for (let f = 0; f < T; f += 2) mask[f] = 0;
        return mask;
    }
    // E5, E10: spatial constraints (complex joint-level masks)
    // For frame-level visualization, show all as generated.
    return mask;
}

