}

/**
 * Draw end-effector constraint markers (for E4 and E6 tasks).
 * Strategy: full-frame trajectory lines per constrained joint + large constraint markers
 * + small dots for unconstrained frames + dashed connections + keypose skeleton outlines.
 */
function drawConstraintMarkers() {
    constraintMarkers.forEach(m => { if (scene) scene.remove(m); });
    constraintMarkers = [];

    // Update the info panel whenever markers are redrawn
    updateConstraintInfoPanel();

    if (!skeletonData || !skeletonData.positions) return;
    if (TASK_ID !== 'E4' && TASK_ID !== 'E6') return;

    const positions = skeletonData.positions;
    const T = positions.length;

    // Joint color mapping (reads from global CONSTRAINT_JOINT_COLORS for single source of truth)
    const getJointColor = (j) => {
        const info = CONSTRAINT_JOINT_COLORS[j];
        return info ? parseInt(info.hex.slice(1), 16) : 0xef4444;
    };
    const getJointLabel = (j) => {
        const info = CONSTRAINT_JOINT_COLORS[j];
        return (info && info.name) ? info.name : (JOINT_DISPLAY_NAMES[j] || `J${j}`);
    };

    let jointIndices = [];
    let frameInterval = 10;

    if (TASK_ID === 'E6') {
        // E6: new single setting 'pos_contact' — both ankles at GT contact frames
        jointIndices = [7, 8];
        frameInterval = 2; // ~contact frames spacing, visualized as sparse markers
    }
    // E4: pure end-effector settings (renamed from A/B/C/D/E/F)
    else if (currentSetting === 'A_rhand_sparse') { jointIndices = [21]; frameInterval = 10; }
    else if (currentSetting === 'B_ankles_sparse') { jointIndices = [7, 8]; frameInterval = 15; }
    else if (currentSetting === 'C_rhand_lfoot') { jointIndices = [21, 10]; frameInterval = 15; }
    else if (currentSetting === 'D_both_hands') { jointIndices = [20, 21]; frameInterval = 10; }
    else if (currentSetting === 'E_all4_sparse') { jointIndices = [20, 21, 7, 8]; frameInterval = 20; }
    else if (currentSetting === 'F_rhand_dense') { jointIndices = [21]; frameInterval = 5; }
    else return;

    // E4: per-frame display — only show constraint markers for joints that are
    // actually constrained at the CURRENT frame. Avoids persistent sphere
    // clutter and the inability to read temporal ordering.
    // E6: keep legacy persistent-trajectory style.
    if (TASK_ID === 'E4') {
        // Constraint frames are {0, frameInterval, 2*frameInterval, ...}.
        const f = currentFrame;
        if (f === undefined || f === null) return;
        if (f % frameInterval !== 0) return;  // not a constraint frame → nothing to draw
        if (!positions[f]) return;

        for (const j of jointIndices) {
            const color = getJointColor(j);
            const label = getJointLabel(j);
            if (!positions[f][j]) continue;
            const p = positions[f][j];

            // Label sprite above the current-frame constraint marker
            const canvas = document.createElement('canvas');
            canvas.width = 128; canvas.height = 48;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = `#${(color).toString(16).padStart(6, '0')}`;
            ctx.fillRect(0, 0, 128, 48);
            ctx.fillStyle = '#fff';
            ctx.font = 'bold 28px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(label, 64, 24);
            const tex = new THREE.CanvasTexture(canvas);
            const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false });
            const sprite = new THREE.Sprite(spriteMat);
            sprite.position.set(p[0], p[1] + groundOffset + 0.12, p[2]);
            sprite.scale.set(0.15, 0.06, 1);
            scene.add(sprite);
            constraintMarkers.push(sprite);

            // Large glowing sphere at the current-frame constraint
            const bigMat = new THREE.MeshStandardMaterial({
                color: color, emissive: color, emissiveIntensity: 0.6,
            });
            const sphere = new THREE.Mesh(new THREE.SphereGeometry(0.04, 12, 12), bigMat);
            sphere.position.set(p[0], p[1] + groundOffset, p[2]);
            scene.add(sphere);
            constraintMarkers.push(sphere);
        }
        return;
    }

    // For E6: full trajectory + constraint markers + joint labels
    for (const j of jointIndices) {
        const color = getJointColor(j);
        const label = getJointLabel(j);

        // 0. Text label sprite at the first constraint position
        {
            const firstFrame = 0;
            if (positions[firstFrame] && positions[firstFrame][j]) {
                const p = positions[firstFrame][j];
                const canvas = document.createElement('canvas');
                canvas.width = 128; canvas.height = 48;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = `#${(color).toString(16).padStart(6, '0')}`;
                ctx.fillRect(0, 0, 128, 48);
                ctx.fillStyle = '#fff';
                ctx.font = 'bold 28px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(label, 64, 24);
                const tex = new THREE.CanvasTexture(canvas);
                const spriteMat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false });
                const sprite = new THREE.Sprite(spriteMat);
                sprite.position.set(p[0], p[1] + groundOffset + 0.08, p[2]);
                sprite.scale.set(0.15, 0.06, 1);
                scene.add(sprite);
                constraintMarkers.push(sprite);
            }
        }

        // 1. [Removed 2026-04-20] Full-frame translucent trajectory line.
        //    Drawing one translucent polyline per constrained joint plus all
        //    the constraint spheres + small dots + dashed connections made
        //    the scene too noisy to read. We now keep ONLY the constraint
        //    spheres and labels. The raw pelvis trajectory (from the SMPL
        //    mesh) is still visible via the motion itself. If you need a
        //    per-joint trail back, wire updateTrajectoryOverlay().

        // 2. Constraint frames: large glowing spheres + dashed connections
        //    For dense constraints (E6 B_rot, interval=1), show thicker trajectory instead
        if (frameInterval <= 1) {
            // Dense: re-render per-frame joint positions as a solid line so
            // the user can see the constrained trajectory even without the
            // translucent overlay that was just removed.
            const densePts = [];
            for (let f = 0; f < T; f++) {
                if (!positions[f] || !positions[f][j]) continue;
                const p = positions[f][j];
                densePts.push(new THREE.Vector3(p[0], p[1] + groundOffset, p[2]));
            }
            if (densePts.length > 1) {
                const solidGeom = new THREE.BufferGeometry().setFromPoints(densePts);
                const solidMat = new THREE.LineBasicMaterial({
                    color: color, transparent: true, opacity: 0.85, linewidth: 2,
                });
                const solidLine = new THREE.Line(solidGeom, solidMat);
                scene.add(solidLine);
                constraintMarkers.push(solidLine);
            }
            // Add a few landmark spheres at regular intervals for visual anchoring
            const landmarkInterval = Math.max(1, Math.floor(T / 8));
            const bigMat = new THREE.MeshStandardMaterial({
                color: color, emissive: color, emissiveIntensity: 0.5,
            });
            for (let f = 0; f < T; f += landmarkInterval) {
                if (!positions[f] || !positions[f][j]) continue;
                const p = positions[f][j];
                const sphere = new THREE.Mesh(new THREE.SphereGeometry(0.025, 8, 8), bigMat);
                sphere.position.set(p[0], p[1] + groundOffset, p[2]);
                scene.add(sphere);
                constraintMarkers.push(sphere);
            }
            continue;
        }

        // Sparse constraints: individual markers + dashed connections
        const constraintFrames = [];
        for (let f = 0; f < T; f += frameInterval) {
            constraintFrames.push(f);
        }

        const bigMat = new THREE.MeshStandardMaterial({
            color: color, emissive: color, emissiveIntensity: 0.5,
        });

        let prevConstraintPos = null;
        for (const f of constraintFrames) {
            if (!positions[f] || !positions[f][j]) continue;
            const p = positions[f][j];
            const pos = new THREE.Vector3(p[0], p[1] + groundOffset, p[2]);

            // Large sphere at constraint frame
            const sphere = new THREE.Mesh(new THREE.SphereGeometry(0.035, 10, 10), bigMat);
            sphere.position.copy(pos);
            scene.add(sphere);
            constraintMarkers.push(sphere);

            // Dashed line connection between consecutive constraint frames
            if (prevConstraintPos) {
                const dashPoints = [prevConstraintPos.clone(), pos.clone()];
                const dashGeom = new THREE.BufferGeometry().setFromPoints(dashPoints);
                const dashMat = new THREE.LineDashedMaterial({
                    color: color, dashSize: 0.03, gapSize: 0.02, transparent: true, opacity: 0.6,
                });
                const dashLine = new THREE.Line(dashGeom, dashMat);
                dashLine.computeLineDistances();
                scene.add(dashLine);
                constraintMarkers.push(dashLine);
            }
            prevConstraintPos = pos;
        }

        // Removed: small dots every 3 frames (created visual clutter per user feedback).
        // The trajectory line (step 1) already conveys the joint's path over time.
    }
}

/**
 * Initialize the body part overlay skeleton group for E10 tasks.
 * This creates a transparent skeleton layer that is always visible,
 * regardless of renderMode (smpl, mesh_seq, or skeleton).
 */
function initBodyPartOverlay() {
    if (bodyPartGroup && scene) { scene.remove(bodyPartGroup); bodyPartGroup = null; }
    if (TASK_ID !== 'E10') return;
    if (!skeletonData || !skeletonData.positions) return;

    bodyPartGroup = new THREE.Group();
    const numJ = Math.min(22, skeletonData.positions[0].length);

    // Determine kept vs regenerated joints based on current setting
    let keptJoints;
    if (currentSetting === 'A_upper') keptJoints = new Set(UPPER_JOINTS); // keep upper
    else if (currentSetting === 'B_lower') keptJoints = new Set(LOWER_JOINTS); // keep lower
    else if (currentSetting === 'C_spine_only') keptJoints = new Set([0, 3, 6, 9, 12, 15]); // pelvis + spine chain + head
    else if (currentSetting === 'C_root_only') keptJoints = new Set([0]); // root only (legacy)
    // Back-compat: older DB entries may have bare A/B/C
    else if (currentSetting === 'A') keptJoints = new Set(UPPER_JOINTS);
    else if (currentSetting === 'B') keptJoints = new Set(LOWER_JOINTS);
    else keptJoints = new Set([0]);

    // Use depthTest=false so the overlay is ALWAYS visible, even when the
    // SMPL mesh would otherwise occlude it. renderOrder=999 ensures it is
    // drawn last, on top of everything. Without this, E10 part-level
    // coloring was completely hidden under the opaque SMPL body mesh —
    // users saw nothing. (2026-04-20 fix)
    const keptMat = new THREE.MeshStandardMaterial({
        color: 0x3b82f6, emissive: 0x3b82f6, emissiveIntensity: 0.4,
        transparent: true, opacity: 0.9, depthTest: false,
    });
    const regenMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b, emissive: 0xf59e0b, emissiveIntensity: 0.4,
        transparent: true, opacity: 0.9, depthTest: false,
    });
    const keptBoneMat = new THREE.MeshStandardMaterial({
        color: 0x3b82f6, transparent: true, opacity: 0.75, depthTest: false,
    });
    const regenBoneMat = new THREE.MeshStandardMaterial({
        color: 0xf59e0b, transparent: true, opacity: 0.75, depthTest: false,
    });

    // Joint spheres: enlarge slightly and give the group a high renderOrder
    // so it is drawn after (on top of) the SMPL mesh.
    for (let i = 0; i < numJ; i++) {
        const mat = keptJoints.has(i) ? keptMat : regenMat;
        const s = new THREE.Mesh(new THREE.SphereGeometry(0.028, 10, 10), mat);
        s.name = `bp_j_${i}`;
        s.renderOrder = 999;
        bodyPartGroup.add(s);
    }

    // Create bone connections
    const edges = skeletonData.edges || [];
    edges.forEach(([c, p], idx) => {
        // Use child joint's category to determine bone color
        const mat = keptJoints.has(c) ? keptBoneMat : regenBoneMat;
        const cyl = new THREE.Mesh(new THREE.CylinderGeometry(0.011, 0.011, 1, 6), mat);
        cyl.name = `bp_b_${idx}`;
        cyl.renderOrder = 999;
        bodyPartGroup.add(cyl);
    });

    scene.add(bodyPartGroup);
    // Apply ground offset
    if (groundOffset) bodyPartGroup.position.y = groundOffset;
}

/**
 * Update body part overlay positions for the current frame.
 * Called from drawFrame() on every frame update.
 */
function updateBodyPartOverlay() {
    if (!bodyPartGroup || TASK_ID !== 'E10') return;
    if (!skeletonData || !skeletonData.positions) return;

    const pos = skeletonData.positions[currentFrame];
    if (!pos) return;

    const numJ = Math.min(22, pos.length);
    for (let i = 0; i < numJ; i++) {
        const s = bodyPartGroup.getObjectByName(`bp_j_${i}`);
        if (s && pos[i]) s.position.set(pos[i][0], pos[i][1], pos[i][2]);
    }

    const edges = skeletonData.edges || [];
    edges.forEach(([c, p], idx) => {
        const cyl = bodyPartGroup.getObjectByName(`bp_b_${idx}`);
        if (!cyl || !pos[c] || !pos[p]) return;
        const p1 = new THREE.Vector3(...pos[p]);
        const p2 = new THREE.Vector3(...pos[c]);
        const mid = new THREE.Vector3().addVectors(p1, p2).multiplyScalar(0.5);
        const len = p1.distanceTo(p2);
        cyl.position.copy(mid);
        cyl.scale.set(1, len || 0.001, 1);
        cyl.lookAt(p2);
        cyl.rotateX(Math.PI / 2);
    });
}

/**
 * Clean up all visualization overlays.
 */
function cleanupOverlays() {
    if (trajectoryLine && scene) { scene.remove(trajectoryLine); trajectoryLine = null; }
    constraintMarkers.forEach(m => { if (scene) scene.remove(m); });
    constraintMarkers = [];
    headingArrows.forEach(a => { if (scene) scene.remove(a); });
    headingArrows = [];
    if (bodyPartGroup && scene) { scene.remove(bodyPartGroup); bodyPartGroup = null; }
}

function drawFrame() {
    // For stitched tasks (E14/15/16), skeleton and SMPL/mesh_seq are stitched to cover
    // the FULL sequence [prefix | network | suffix]. We render the best mesh available
    // at every frame and color it per-region (C=blue, G=amber, N=gray). Skeleton acts
    // as fallback if no mesh data has loaded yet or a specific frame has no mesh data.
    //
    // Two sources of mesh data:
    //   - smplData.frames: from /api/smpl for SMPL-based runs (our M2M models). For
    //     stitched tasks these frames are re-stitched with source motion SMPL params.
    //   - meshSeqData (vertices_b64): from /api/smpl for KIMODO (returns precomputed
    //     LBS-skinned SOMA mesh). NOT currently stitched — only covers the gen span.
    const isStitched = (TASK_ID === 'E14');
    let effectiveRenderMode = renderMode;
    let meshFrameIdx = currentFrame; // frame index to use for SMPL/mesh_seq
    if (isStitched) {
        const prefixLen = (sourceMotionCtx && sourceMotionCtx.prefixLen) || 0;
        const networkLen = (sourceMotionCtx && sourceMotionCtx.networkLen) || 0;
        const networkStart = prefixLen;
        const networkEnd = prefixLen + networkLen;  // exclusive

        // smplData.frames may be stitched to full length (if source provided
        // compatible smpl_frames) OR may still be network-only (~networkLen
        // frames). Detect the latter so we can map currentFrame → mesh-local
        // idx when inside the network span, and fall back to skeleton outside.
        const smplArrLen = smplData && smplData.frames ? smplData.frames.length : 0;
        const smplStitched = smplArrLen >= (prefixLen + networkLen + (sourceMotionCtx.suffixLen || 0));
        const smplReady = smplData && smplData.frames && (
            smplStitched
                ? !!smplData.frames[currentFrame]
                : (currentFrame >= networkStart && currentFrame < networkEnd
                    && !!smplData.frames[currentFrame - networkStart])
        );
        // mesh_seq (KIMODO SOMA) is NEVER stitched — only covers network span.
        const meshSeqAvailable = meshSeqData && meshSeqMesh;
        const inNetwork = networkLen > 0
            ? (currentFrame >= networkStart && currentFrame < networkEnd)
            : false;

        if (smplReady) {
            effectiveRenderMode = 'smpl';
            meshFrameIdx = smplStitched ? currentFrame : (currentFrame - networkStart);
        } else if (meshSeqAvailable && inNetwork) {
            effectiveRenderMode = 'mesh_seq';
            meshFrameIdx = currentFrame - networkStart;
            // Clamp to valid meshSeqData range
            if (meshFrameIdx < 0) meshFrameIdx = 0;
            if (meshFrameIdx >= meshSeqData.num_frames) meshFrameIdx = meshSeqData.num_frames - 1;
        } else {
            effectiveRenderMode = 'skeleton';
        }
        if (skeletonGroup) skeletonGroup.visible = (effectiveRenderMode === 'skeleton');
        if (smplMesh) smplMesh.visible = (effectiveRenderMode === 'smpl');
        if (meshSeqMesh) meshSeqMesh.visible = (effectiveRenderMode === 'mesh_seq');
    }

    if (effectiveRenderMode === 'smpl') {
        drawFrameSMPL(meshFrameIdx);
    } else if (effectiveRenderMode === 'skeleton') {
        drawFrameSkeleton();
    } else if (effectiveRenderMode === 'mesh_seq') {
        drawFrameMeshSeq(meshFrameIdx);
    }
    // Update mesh color based on region (C=blue, G=amber, N=gray)
    if (currentFrameMask && currentFrameMask.length > currentFrame) {
        const region = currentFrameMask[currentFrame];
        const color = REGION_HEX[region] !== undefined ? REGION_HEX[region] : 0xf59e0b;
        const emissive = REGION_EMISSIVE[region] !== undefined ? REGION_EMISSIVE[region] : 0x4a3000;
        if (smplMesh && smplMesh.material) { smplMesh.material.color.setHex(color); smplMesh.material.emissive.setHex(emissive); }
        if (meshSeqMesh && meshSeqMesh.material) { meshSeqMesh.material.color.setHex(color); meshSeqMesh.material.emissive.setHex(emissive); }
    }
    // Body part overlay for E10: always-on skeleton layer (works with any renderMode)
    updateBodyPartOverlay();
    // Dynamic trajectory trail + heading arrow (E5/E8 with trajectory/heading conditions)
    updateTrajectoryOverlay();
    // E9: update LQ ghost skeleton overlay (if toggled on by user)
    _updateLQOverlayFrame();
    const nf = getEffectiveFrameCount();
    document.getElementById('frameSlider').value = currentFrame;
    document.getElementById('frameInfo').textContent = `${currentFrame} / ${nf - 1}`;
    // Update mask label
    const lbl = document.getElementById('maskFrameLabel');
    if (lbl && currentFrameMask && currentFrameMask.length > currentFrame) {
        const region = currentFrameMask[currentFrame];
        lbl.textContent = REGION_LABELS[region] || 'GEN';
        lbl.style.color = REGION_COLORS[region] || COLOR_GEN;
    }

    // E4: redraw constraint markers each frame so that only the constraint
    // at the current frame is visible (no persistent clutter).
    if (TASK_ID === 'E4') {
        drawConstraintMarkers();
    }
}

function drawFrameSkeleton() {
    if (!skeletonData) return;
    const pos = skeletonData.positions[currentFrame];
    if (!pos) return;
    updateSkeletonPositions(pos, skeletonData.edges, skeletonGroup);
}

function drawFrameSMPL(frameIdxOverride) {
    if (!smplData || !smplBones) return;
    const fi = (frameIdxOverride !== undefined) ? frameIdxOverride : currentFrame;
    const frame = smplData.frames[fi];
    if (!frame || !frame[0]) return;
    const p = frame[0];
    const _axis = new THREE.Vector3();
    const _quat = new THREE.Quaternion();

    // Root rotation
    if (p.Rh && p.Rh[0]) {
        _axis.set(p.Rh[0][0], p.Rh[0][1], p.Rh[0][2]);
        const angle = _axis.length();
        if (angle > 1e-8) { _axis.normalize(); _quat.setFromAxisAngle(_axis, angle); }
        else _quat.identity();
        smplBones[0].quaternion.copy(_quat);
    }
    // Translation
    if (p.Th && p.Th[0]) {
        smplBones[0].position.set(p.Th[0][0], p.Th[0][1], p.Th[0][2]);
    }
    // Joint poses
    const poses = p.poses[0];
    const numJ = smplEdges ? smplEdges.length : 22;
    const off = (poses && poses.length === (numJ - 1) * 3) ? -3 : 0;
    for (let i = 1; i < numJ && i < smplBones.length; i++) {
        const base = off + 3 * i;
        if (base < 0 || base + 2 >= poses.length) continue;
        _axis.set(poses[base], poses[base+1], poses[base+2]);
        const angle = _axis.length();
        if (angle > 1e-8) { _axis.normalize(); _quat.setFromAxisAngle(_axis, angle); }
        else _quat.identity();
        smplBones[i].quaternion.copy(_quat);
    }
}

function seekFrame(val) { currentFrame = parseInt(val); drawFrame(); }

function rewriteCaption() {
    const s = filteredSamples[currentIdx];
    if (!s || !s.text_caption) return;
    const btn = document.getElementById('btnRewriteCaption');
    const rewrittenSpan = document.getElementById('rewrittenCaption');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Rewriting...';
    fetch('/api/rewrite_caption', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({caption: s.text_caption}),
    }).then(r => r.json()).then(data => {
        if (data.error) {
            rewrittenSpan.textContent = '⚠ ' + data.error;
            rewrittenSpan.style.color = '#ef4444';
        } else {
            rewrittenSpan.textContent = '→ ' + data.rewritten;
            rewrittenSpan.style.color = '#10b981';
        }
        rewrittenSpan.style.display = 'inline';
        btn.innerHTML = '<i class="fas fa-check me-1"></i>Done';
    }).catch(e => {
        rewrittenSpan.textContent = '⚠ ' + e.message;
        rewrittenSpan.style.color = '#ef4444';
        rewrittenSpan.style.display = 'inline';
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-language me-1"></i>Rewrite';
    });
}

let lastFrameTime = 0;

/**
 * Determine the effective number of frames for playback.
 * For E14, skeleton data is stitched to include source+gen+target,
 * but SMPL/mesh data only covers the generated middle section. We always
 * use skeleton length to avoid mid-motion truncation.
 */
function getEffectiveFrameCount() {
    const isStitched = (TASK_ID === 'E14');
    if (isStitched && skeletonData) return skeletonData.num_frames || 1;
    if (renderMode === 'smpl') return smplData ? smplData.num_frames : 1;
    if (renderMode === 'mesh_seq') return meshSeqData ? meshSeqData.num_frames : 1;
    return skeletonData ? skeletonData.num_frames : 1;
}

function frameAnimate(time) {
    if (!framePlaying) return;
    frameAnimId = requestAnimationFrame(frameAnimate);
    if (time - lastFrameTime > 33) {
        const nf = getEffectiveFrameCount();
        // E8 loop: skip last frame to avoid discontinuity (last≠first in old data)
        const effectiveNf = (TASK_ID === 'E8' && nf > 2) ? nf - 1 : nf;
        currentFrame = (currentFrame + 1) % effectiveNf;
        drawFrame();
        lastFrameTime = time;
    }
}
function toggleFramePlay() {
    framePlaying = !framePlaying;
    const icon = document.getElementById('framePlayIcon');
    icon.classList.toggle('fa-play', !framePlaying);
    icon.classList.toggle('fa-pause', framePlaying);
    if (framePlaying) { lastFrameTime = performance.now(); requestAnimationFrame(frameAnimate); }
    else if (frameAnimId) cancelAnimationFrame(frameAnimId);
}
function toggleAutoPlay() {
    // Legacy — replaced by randomSample
    randomSample();
}
