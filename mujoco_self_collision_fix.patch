+    def _disable_self_collisions(self) -> None:
+        """Disable collisions between robot body parts.
+
+        Sets geom_conaffinity to 0 for all robot geoms. This prevents contact
+        forces from arising due to natural interpenetration in the rest pose
+        (e.g., shoulders, hips). The SMPL humanoid has interpenetrating
+        geometry that would cause unstable repulsive forces if left enabled.
+
+        Body 0 is the floor (world), bodies 1+ are robot bodies with geoms.
+        We use geom_bodyid to identify which body each geom belongs to.
+        """
+        for gid in range(self.model.ngeom):
+            body_id = self.model.geom_bodyid[gid]
+            # Only disable for robot bodies (skip floor/world)
+            if 0 < body_id < self._num_bodies:
+                self.model.geom_conaffinity[gid] = 0
+
